attribute [local instance] MvPolynomial.gradedAlgebra

/-- Irreducible projective variety has a point (copied from Intersections private lemma). -/
theorem mACone_projective_nonempty {n : ℕ} (V : ProjectiveVariety n)
    (hV : V.IsIrreducible) : V.points.Nonempty := by
  classical
  by_contra hne
  have hcone : V.affineCone.points ⊆ ({0} : Set (Point n)) := by
    intro x hx
    by_contra hnot
    have hx0 : x ≠ 0 := by simpa using hnot
    have hproj : Projectivization.mk ℂ x hx0 ∈ V.points :=
      (ProjectiveVariety.mem_points_mk_iff V x hx0).2 hx
    exact hne ⟨Projectivization.mk ℂ x hx0, hproj⟩
  have hcoord : ∀ i : Fin n, MvPolynomial.X i ∈ V.ideal := by
    intro i
    change MvPolynomial.X i ∈ V.affineCone.ideal
    rw [← AffineVariety.vanishingIdeal_points V.affineCone,
      MvPolynomial.mem_vanishingIdeal_iff]
    intro x hx
    have hx0 : x = 0 := by simpa using hcone hx
    subst x
    simp
  have hone : (1 : Poly n) ∈ V.ideal := by
    apply V.isSaturated
    intro i
    exact ⟨1, by simpa using hcoord i⟩
  exact hV.ne_top (V.ideal.eq_top_iff_one.mpr hone)

/-- Minimal prime of a homogeneous ideal is homogeneous (via homogeneous core). -/
theorem mACone_minimalPrime_homogeneous {n : ℕ} (I : Ideal (Poly n))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin n) ℂ))
    (P : Ideal (Poly n)) (hP : P ∈ I.minimalPrimes) :
    P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin n) ℂ) := by
  classical
  have hPmin : I.IsMinimalPrime P := hP
  have hPprime : P.IsPrime := hPmin.isPrime
  have hIP : I ≤ P := hPmin.le
  have : P.IsPrime := hPprime
  let A := MvPolynomial.homogeneousSubmodule (Fin n) ℂ
  let H : Ideal (Poly n) := (P.homogeneousCore A).toIdeal
  have hHle : H ≤ P := Ideal.toIdeal_homogeneousCore_le A _
  have hHprime : H.IsPrime := hPprime.homogeneousCore
  have hIH : I ≤ H := by
    have hcoreI : (I.homogeneousCore A).toIdeal = I := hI.toIdeal_homogeneousCore_eq_self
    have hmono : (I.homogeneousCore A) ≤ (P.homogeneousCore A) :=
      Ideal.homogeneousCore_mono A hIP
    have hmonoIdeal : (I.homogeneousCore A).toIdeal ≤ (P.homogeneousCore A).toIdeal :=
      hmono
    rwa [hcoreI] at hmonoIdeal
  have hHP : H = P := hPmin.eq_of_le ⟨hHprime, hIH⟩ hHle
  rw [← hHP]
  exact (P.homogeneousCore A).isHomogeneous

/-- A prime of affine dimension two in three variables is principal, generated by a prime. -/
theorem mACone_prime_dim2_principal {P : Ideal (Poly 3)} [P.IsPrime]
    (hPdim : OAI.QuarticPowerFree.affineDimension P = 2) :
    ∃ q : Poly 3, Prime q ∧ Ideal.span {q} = P := by
  classical
  have hsum := affineDimension_add_height (Q := P)
  rw [hPdim] at hsum
  -- hsum : ((2 : ℕ) : ℕ∞) + P.height = 3; deduce height = 1
  have hht : P.height = 1 := by
    have hne : P.height ≠ ⊤ := by
      intro htop
      rw [htop, add_top] at hsum
      exact ENat.top_ne_natCast 3 hsum
    obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
    rw [← hm, ← Nat.cast_add] at hsum
    -- hsum : ((2 + m : ℕ) : ℕ∞) = (3 : ℕ)
    have hnat : 2 + m = 3 := Nat.cast_injective hsum
    have hm1 : m = 1 := by omega
    rw [← hm]
    exact (congr_arg (Nat.cast : ℕ → ℕ∞) hm1).trans Nat.cast_one
  have hprincipal : P.IsPrincipal :=
    UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hht
  obtain ⟨q, hq⟩ := hprincipal
  have hqne : q ≠ 0 := by
    intro hz
    have hbot : P = ⊥ := by rw [hq, hz, Ideal.span_singleton_eq_bot]
    have hht0 : P.height = 0 := by rw [hbot, Ideal.height_eq_zero_iff_eq_bot.mpr rfl]
    rw [hht] at hht0
    exact one_ne_zero hht0
  have hspanPrime : (Ideal.span {q}).IsPrime := by
    have hPprime : P.IsPrime := inferInstance
    rwa [hq] at hPprime
  have hprime : Prime q := (Ideal.span_singleton_prime hqne).mp hspanPrime
  exact ⟨q, hprime, hq.symm⟩

/-- A principal homogeneous prime is generated by a homogeneous prime element. -/
theorem mACone_principal_homogeneous {P : Ideal (Poly 3)}
    (hPhom : P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 3) ℂ))
    (q : Poly 3) (hprime : Prime q) (hP : Ideal.span {q} = P) :
    q.IsHomogeneous q.totalDegree := by
  classical
  have hqne : q ≠ 0 := hprime.ne_zero
  have hqmem : q ∈ P := by rw [← hP]; exact Ideal.mem_span_singleton_self q
  set D := q.totalDegree with hD
  -- For each degree d, the homogeneous component lies in P, hence is divisible by q.
  have hcomp : ∀ d : ℕ, q ∣ MvPolynomial.homogeneousComponent d q := by
    intro d
    have hmem : MvPolynomial.homogeneousComponent d q ∈ P :=
      MvPolynomial.homogeneousComponent_mem_of_mem hPhom hqmem d
    rw [← hP] at hmem
    exact Ideal.mem_span_singleton.mp hmem
  -- Only the top component survives; q equals it.
  have hsum := MvPolynomial.sum_homogeneousComponent q
  rw [← hD] at hsum
  have hsingle : (∑ i ∈ Finset.range (D + 1),
      MvPolynomial.homogeneousComponent i q) =
      MvPolynomial.homogeneousComponent D q := by
    apply Finset.sum_eq_single D
    · intro b hb hbne
      have hbD : b < D := by
        have hble : b ≤ D := by
          have hmem : b ∈ Finset.range (D + 1) := hb
          exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hmem)
        omega
      have hzero : MvPolynomial.homogeneousComponent b q = 0 := by
        by_contra hnz
        have hhom : (MvPolynomial.homogeneousComponent b q).IsHomogeneous b :=
          MvPolynomial.homogeneousComponent_isHomogeneous b q
        have htd : (MvPolynomial.homogeneousComponent b q).totalDegree = b :=
          hhom.totalDegree hnz
        have hle : q.totalDegree ≤ (MvPolynomial.homogeneousComponent b q).totalDegree :=
          MvPolynomial.totalDegree_le_of_dvd_of_isDomain (hcomp b) hnz
        omega
      exact hzero
    · intro hmem
      have hlt : D < D + 1 := Nat.lt_succ_self _
      have hmem' : D ∈ Finset.range (D + 1) := Finset.mem_range.mpr hlt
      exact False.elim (hmem hmem')
  rw [hsingle] at hsum
  -- hsum : homogeneousComponent D q = q; rewrite to get homogeneity of q.
  have hqeq : q = MvPolynomial.homogeneousComponent D q := hsum.symm
  rw [hqeq]
  exact MvPolynomial.homogeneousComponent_isHomogeneous D q

/-- A polynomial vanishing at the origin lies in the span of the variables. -/
theorem mACone_mem_span_X_of_eval_zero {f : Poly 3}
    (hf : MvPolynomial.eval 0 f = 0) :
    f ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 3 → Poly 3)) := by
  classical
  have hcoeff0 : f.coeff 0 = 0 := by
    have heval : MvPolynomial.eval (0 : Fin 3 → ℂ) f = f.coeff 0 := by
      simp [MvPolynomial.constantCoeff_eq]
    rw [heval] at hf
    exact hf
  have hsum : f = ∑ s ∈ f.support, MvPolynomial.monomial s (f.coeff s) :=
    MvPolynomial.as_sum f
  rw [hsum]
  apply Ideal.sum_mem
  intro s hs
  have hcoeffne : f.coeff s ≠ 0 := Finsupp.mem_support_iff.mp hs
  have hsne : s ≠ 0 := by
    intro hz
    subst hz
    exact hcoeffne hcoeff0
  -- s ≠ 0 as a Finsupp, so some coordinate is nonzero.
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, s i ≠ 0 := by
    have hsup_ne : s.support ≠ ∅ := by
      intro hempty
      apply hsne
      exact Finsupp.support_eq_empty.mp hempty
    obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hsup_ne
    exact ⟨i, Finsupp.mem_support_iff.mp hi⟩
  have hdvd : MvPolynomial.X i ∣ MvPolynomial.monomial s (f.coeff s) := by
    rw [MvPolynomial.X_dvd_monomial]
    exact Or.inr hi
  have hmem_single : MvPolynomial.monomial s (f.coeff s) ∈ Ideal.span ({MvPolynomial.X i} : Set (Poly 3)) :=
    Ideal.mem_span_singleton.mpr hdvd
  have hle : Ideal.span ({MvPolynomial.X i} : Set (Poly 3)) ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin 3 → Poly 3)) := by
    apply Ideal.span_mono
    intro y hy
    obtain rfl := Set.mem_singleton_iff.mp hy
    exact Set.mem_range_self i
  exact hle hmem_single

/-- Every element of a homogeneous proper ideal vanishes at the origin. -/
theorem mACone_homogeneous_eval_zero {P : Ideal (Poly 3)} [P.IsPrime]
    (hPhom : P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 3) ℂ))
    (f : Poly 3) (hf : f ∈ P) : MvPolynomial.eval 0 f = 0 := by
  classical
  have htop : P ≠ ⊤ := (inferInstance : P.IsPrime).ne_top
  -- Degree-zero component lies in P; it must vanish or P would be top.
  have hmem0 : MvPolynomial.homogeneousComponent 0 f ∈ P :=
    MvPolynomial.homogeneousComponent_mem_of_mem hPhom hf 0
  have hcomp0 : MvPolynomial.homogeneousComponent 0 f = MvPolynomial.C (f.coeff 0) := by
    simp [MvPolynomial.homogeneousComponent_zero]
  have hcoeff0 : f.coeff 0 = 0 := by
    by_contra hne
    have hunitC : IsUnit (MvPolynomial.C (f.coeff 0) : Poly 3) := by
      have hunit : IsUnit (f.coeff 0 : ℂ) := isUnit_iff_ne_zero.mpr hne
      exact hunit.map (MvPolynomial.C : ℂ →+* Poly 3)
    have hunit : IsUnit (MvPolynomial.homogeneousComponent 0 f : Poly 3) := by
      rw [hcomp0]
      exact hunitC
    exact htop (Ideal.eq_top_of_isUnit_mem P hmem0 hunit)
  have heval : MvPolynomial.eval (0 : Fin 3 → ℂ) f = f.coeff 0 := by
    simp [MvPolynomial.constantCoeff_eq]
  rw [heval, hcoeff0]

/-- Some minimal prime of a nonempty projective variety contains a nonzero cone point. -/
theorem mACone_exists_minimal_with_nonzero {C : ProjectiveVariety 3}
    (hne : C.points.Nonempty) :
    ∃ P ∈ C.ideal.minimalPrimes, ∃ x : Point 3, x ≠ 0 ∧
      x ∈ MvPolynomial.zeroLocus ℂ P := by
  classical
  obtain ⟨p, hp⟩ := hne
  have hrep_ne : p.rep ≠ 0 := p.rep_nonzero
  have hrep_mk : Projectivization.mk ℂ p.rep hrep_ne = p := Projectivization.mk_rep p
  have hrep_cone : p.rep ∈ MvPolynomial.zeroLocus ℂ C.ideal := by
    have hmem : Projectivization.mk ℂ p.rep hrep_ne ∈ C.points := by
      rwa [hrep_mk]
    exact (ProjectiveVariety.mem_points_mk_iff C p.rep hrep_ne).mp hmem
  -- C.ideal ≤ pointIdeal p.rep, since p.rep vanishes on C.ideal.
  have hle : C.ideal ≤ DistinctDistances.pointIdeal p.rep := by
    intro f hf
    have hzero := (MvPolynomial.mem_zeroLocus_iff.mp hrep_cone) f hf
    -- hzero : aeval p.rep f = 0; need f ∈ vanishingIdeal {p.rep}, i.e., eval =0.
    change f ∈ MvPolynomial.vanishingIdeal ℂ ({p.rep} : Set (Point 3))
    rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
    simpa [MvPolynomial.aeval_eq_eval] using hzero
  have hmax := DistinctDistances.pointIdeal_isMaximal p.rep
  have hprime : (DistinctDistances.pointIdeal p.rep).IsPrime := hmax.isPrime
  haveI := hprime
  obtain ⟨P, hPmin, hPle⟩ := Ideal.exists_minimalPrimes_le hle
  refine ⟨P, hPmin, p.rep, hrep_ne, ?_⟩
  rw [MvPolynomial.mem_zeroLocus_iff]
  intro f hf
  have hmem : f ∈ DistinctDistances.pointIdeal p.rep := hPle hf
  change f ∈ MvPolynomial.vanishingIdeal ℂ ({p.rep} : Set (Point 3)) at hmem
  have heval := (MvPolynomial.mem_vanishingIdeal_singleton_iff p.rep f).mp hmem
  simpa [MvPolynomial.aeval_eq_eval] using heval

/-- No minimal prime of a nonempty projective variety contains all variables. -/
theorem mACone_no_minimal_contains_X {C : ProjectiveVariety 3}
    (hne : C.points.Nonempty) (P1 : Ideal (Poly 3)) (hP1 : P1 ∈ C.ideal.minimalPrimes) :
    ∃ i : Fin 3, MvPolynomial.X i ∉ P1 := by
  classical
  by_contra hcon
  push_neg at hcon
  -- hcon : ∀ i, X i ∈ P1.
  have hP1min : C.ideal.IsMinimalPrime P1 := hP1
  have hP1prime : P1.IsPrime := hP1min.isPrime
  -- Obtain P0 with a nonzero point.
  obtain ⟨P0, hP0min, x0, hx0ne, hx0mem⟩ := mACone_exists_minimal_with_nonzero hne
  have hP0prime : P0.IsPrime := hP0min.isPrime
  have hP0le : C.ideal ≤ P0 := hP0min.le
  -- P0 is homogeneous (since C.ideal homogeneous).
  have hP0hom : P0.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 3) ℂ) :=
    mACone_minimalPrime_homogeneous C.ideal C.isHomogeneous P0 hP0min
  haveI := hP0prime
  -- Every f ∈ P0 lies in the span of variables (since it vanishes at 0).
  have hP0leSpan : P0 ≤ Ideal.span (Set.range (MvPolynomial.X : Fin 3 → Poly 3)) := by
    intro f hf
    have heval : MvPolynomial.eval (0 : Fin 3 → ℂ) f = 0 :=
      mACone_homogeneous_eval_zero hP0hom f hf
    exact mACone_mem_span_X_of_eval_zero heval
  -- Span lies in P1 (since all X_i ∈ P1).
  have hSpanleP1 : Ideal.span (Set.range (MvPolynomial.X : Fin 3 → Poly 3)) ≤ P1 := by
    apply Ideal.span_le.mpr
    intro y hy
    obtain ⟨i, rfl⟩ := Set.mem_range.mp hy
    exact hcon i
  have hP0leP1 : P0 ≤ P1 := hP0leSpan.trans hSpanleP1
  -- By minimality of P1, P0 = P1.
  have hIP0 : C.ideal ≤ P0 := hP0min.le
  have heq : P0 = P1 := hP1min.eq_of_le ⟨hP0prime, hIP0⟩ hP0leP1
  -- x0 lies in zeroLocus P1, hence all coords vanish, so x0 = 0. Contradiction.
  have hx0P1 : x0 ∈ MvPolynomial.zeroLocus ℂ P1 := heq ▸ hx0mem
  have hx0zero : x0 = 0 := by
    funext i
    have hXi : MvPolynomial.X i ∈ P1 := hcon i
    have hzero := (MvPolynomial.mem_zeroLocus_iff.mp hx0P1) (MvPolynomial.X i) hXi
    simpa [MvPolynomial.aeval_eq_eval] using hzero
  exact hx0ne hx0zero

/-- A prime missing a variable is irrelevant-saturated. -/
theorem mACone_prime_saturated {P : Ideal (Poly 3)} [P.IsPrime]
    (hX : ∃ i : Fin 3, MvPolynomial.X i ∉ P) : IrrelevantSaturated P := by
  classical
  obtain ⟨i0, hi0⟩ := hX
  intro f hf
  obtain ⟨r, hr⟩ := hf i0
  -- hr : X_i0^r * f ∈ P. Induct on r to strip powers of X_i0 (which is not in P).
  have aux : ∀ r : ℕ, MvPolynomial.X i0 ^ r * f ∈ P → f ∈ P := by
    intro r
    induction r with
    | zero =>
      intro h
      simpa using h
    | succ r ih =>
      intro h
      have hpow : MvPolynomial.X i0 ^ (r + 1) * f =
          MvPolynomial.X i0 * (MvPolynomial.X i0 ^ r * f) := by
        ring
      rw [hpow] at h
      have hprime : P.IsPrime := inferInstance
      rcases hprime.mem_or_mem h with hXi | hrest
      · exact False.elim (hi0 hXi)
      · exact ih hrest
  exact aux r hr

/-- Plane curve equation from component generators (keystone for polar_choice). -/
theorem mACone_plane_curve_equation (C : ProjectiveVariety 3) (hC : C.IsPure 1)
    (hne : C.points.Nonempty) :
    ∃ f : Poly 3, f ≠ 0 ∧ f.IsHomogeneous f.totalDegree ∧ C.ideal = Ideal.span {f} := by
  classical
  -- Step 1: each component has a homogeneous prime generator.
  have hcomp : ∀ W : C.Component, ∃ q : Poly 3, Prime q ∧ q.IsHomogeneous q.totalDegree ∧
      Ideal.span {q} = W.val.ideal := by
    intro W
    have hWmin : C.ideal.IsMinimalPrime W.val.ideal := W.property
    have hWprime : W.val.ideal.IsPrime := hWmin.isPrime
    haveI := hWprime
    have hdim1 : W.val.dimension = 1 := hC W
    have hWne : W.val.points.Nonempty :=
      mACone_projective_nonempty W.val W.property.isPrime
    have hcone : W.val.affineCone.dimension = 2 := by
      rw [ProjectiveVariety.dimension_cone W.val hWne, hdim1]
    have hdim2 : OAI.QuarticPowerFree.affineDimension W.val.ideal = 2 := hcone
    obtain ⟨q, hqprime, hqspan⟩ := mACone_prime_dim2_principal hdim2
    have hqhom : q.IsHomogeneous q.totalDegree :=
      mACone_principal_homogeneous W.val.isHomogeneous q hqprime hqspan
    exact ⟨q, hqprime, hqhom, hqspan⟩
  choose q hqprime hqhom hqspan using hcomp
  -- f is the product over all components.
  let f : Poly 3 := ∏ W : C.Component, q W
  have hqne : ∀ W : C.Component, q W ≠ 0 := fun W => (hqprime W).ne_zero
  have hfne : f ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun W _ => hqne W)
  -- Pairwise IsRelPrime for distinct components (via distinct prime ideals).
  have hpair : ((Finset.univ : Finset C.Component) : Set C.Component).Pairwise (IsRelPrime.onFun q) := by
    intro W1 hW1 W2 hW2 hne12
    show IsRelPrime (q W1) (q W2)
    intro d hd1 hd2
    -- d ∣ q W1 with q W1 irreducible; so d unit or q W1 = d * k with k unit.
    have hirr1 : Irreducible (q W1) := (hqprime W1).irreducible
    obtain ⟨k1, hk1⟩ := hd1
    -- hk1 : q W1 = d * k1.
    rcases hirr1.isUnit_or_isUnit hk1 with hunit_d | hunit_k1
    · exact hunit_d
    · -- k1 is a unit, so q W1 ∣ q W2 (via d), hence ideals comparable, hence components equal. Contradiction.
      obtain ⟨k2, hk2⟩ := hd2
      -- hk2 : q W2 = d * k2. Need q W1 ∣ q W2.
      have hdiv12 : q W1 ∣ q W2 := by
        obtain ⟨u, hu⟩ := hunit_k1
        have hk1u : q W1 = d * (u : Poly 3) := hu.symm ▸ hk1
        have hq1d : q W1 ∣ d := by
          refine ⟨((u⁻¹ : (Poly 3)ˣ) : Poly 3), ?_⟩
          have hunit_inv : (u : Poly 3) * (((u⁻¹ : (Poly 3)ˣ)) : Poly 3) = 1 := by simp
          calc
            d = d * 1 := by rw [mul_one]
            _ = d * ((u : Poly 3) * (((u⁻¹ : (Poly 3)ˣ)) : Poly 3)) := by rw [hunit_inv]
            _ = (d * (u : Poly 3)) * (((u⁻¹ : (Poly 3)ˣ)) : Poly 3) := by rw [mul_assoc]
            _ = q W1 * (((u⁻¹ : (Poly 3)ˣ)) : Poly 3) := by rw [← hk1u]
        exact dvd_trans hq1d ⟨k2, hk2⟩
      -- From q W1 ∣ q W2, get W2.ideal ≤ W1.ideal, hence equal by minimality, hence W1 = W2. Contradiction.
      have hspan_le : Ideal.span ({q W2} : Set (Poly 3)) ≤ Ideal.span ({q W1} : Set (Poly 3)) := by
        apply Ideal.span_le.mpr
        intro y hy
        obtain rfl := Set.mem_singleton_iff.mp hy
        exact Ideal.mem_span_singleton.mpr hdiv12
      have hideal_le : W2.val.ideal ≤ W1.val.ideal := by
        rw [← hqspan W2, ← hqspan W1]
        exact hspan_le
      have hW2min : C.ideal.IsMinimalPrime W2.val.ideal := W2.property
      have hW1min : C.ideal.IsMinimalPrime W1.val.ideal := W1.property
      have hW2prime : W2.val.ideal.IsPrime := hW2min.isPrime
      have hCle : C.ideal ≤ W2.val.ideal := hW2min.le
      have heq : W2.val.ideal = W1.val.ideal := hW1min.eq_of_le ⟨hW2prime, hCle⟩ hideal_le
      have hvaleq : W1.val = W2.val := ProjectiveVariety.ext heq.symm
      have hsubeq : W1 = W2 := Subtype.ext hvaleq
      exact False.elim (hne12 hsubeq)
  -- f is homogeneous (product of homogeneous) and nonzero, so of its total degree.
  have hfhom_sum : f.IsHomogeneous (∑ W : C.Component, (q W).totalDegree) := by
    have hhom_each : ∀ W ∈ (Finset.univ : Finset C.Component), (q W).IsHomogeneous (q W).totalDegree :=
      fun W _ => hqhom W
    have hprod := MvPolynomial.IsHomogeneous.prod (Finset.univ : Finset C.Component) q
      (fun W => (q W).totalDegree) hhom_each
    simpa [f] using hprod
  have hftotal : f.totalDegree = ∑ W : C.Component, (q W).totalDegree :=
    hfhom_sum.totalDegree hfne
  have hfhom : f.IsHomogeneous f.totalDegree := by rw [hftotal]; exact hfhom_sum
  -- Classification: every minimal prime is a component ideal (via homogeneous + saturated).
  have hclass : ∀ P ∈ C.ideal.minimalPrimes, ∃ W : C.Component, W.val.ideal = P := by
    intro P hP
    have hPmin : C.ideal.IsMinimalPrime P := hP
    have hPprime : P.IsPrime := hPmin.isPrime
    haveI := hPprime
    have hPhom : P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 3) ℂ) :=
      mACone_minimalPrime_homogeneous C.ideal C.isHomogeneous P hP
    obtain ⟨i, hi⟩ := mACone_no_minimal_contains_X hne P hP
    have hPsat : IrrelevantSaturated P := mACone_prime_saturated ⟨i, hi⟩
    have hPrad : P.IsRadical := hPprime.isRadical
    let Wp : ProjectiveVariety 3 := ⟨P, hPrad, hPhom, hPsat⟩
    have hWcomp : Wp.IsComponentOf C := hP
    -- Wp.ideal = P definitionally (as structure with ideal P), so ⟨Wp, hWcomp⟩ is component with ideal P.
    exact ⟨⟨Wp, hWcomp⟩, rfl⟩
  -- C.ideal ≤ span{f}: every g ∈ C.ideal is divisible by each q W, hence by product (pairwise IsRelPrime).
  have hCleSpan : C.ideal ≤ Ideal.span {f} := by
    intro g hg
    have hdiv_each : ∀ W ∈ (Finset.univ : Finset C.Component), q W ∣ g := by
      intro W _
      have hgle : g ∈ W.val.ideal := (W.property.le) hg
      rw [← hqspan W] at hgle
      exact Ideal.mem_span_singleton.mp hgle
    have hprod_dvd : f ∣ g := by
      have hpair' : ((Finset.univ : Finset C.Component) : Set C.Component).Pairwise (IsRelPrime.onFun q) := hpair
      have hprod : (∏ W ∈ (Finset.univ : Finset C.Component), q W) ∣ g :=
        Finset.prod_dvd_of_isRelPrime hpair' hdiv_each
      simpa [f] using hprod
    exact Ideal.mem_span_singleton.mpr hprod_dvd
  -- span{f} ≤ C.ideal: f lies in every minimal prime, hence in sInf = C.ideal.
  have hSpanleC : Ideal.span {f} ≤ C.ideal := by
    apply Ideal.span_le.mpr
    intro y hy
    obtain rfl := Set.mem_singleton_iff.mp hy
    -- Show f ∈ C.ideal via sInf (since C.ideal radical, sInf minimalPrimes = C.ideal).
    have hrad : sInf C.ideal.minimalPrimes = C.ideal := by
      rw [Ideal.sInf_minimalPrimes, C.isRadical.radical]
    rw [← hrad]
    apply Ideal.mem_sInf.mpr
    intro P hP
    obtain ⟨W, hW⟩ := hclass P hP
    -- hW : W.val.ideal = P. Show f ∈ W.val.ideal (since product contains factor q W).
    have hfW : f ∈ W.val.ideal := by
      have hmem : q W ∈ W.val.ideal := by rw [← hqspan W]; exact Ideal.mem_span_singleton_self _
      have hprod_mem : (∏ V : C.Component, q V) ∈ W.val.ideal := by
        have hfactor : q W ∣ (∏ V : C.Component, q V) := Finset.dvd_prod_of_mem _ (Finset.mem_univ W)
        obtain ⟨k, hk⟩ := hfactor
        rw [hk]
        exact W.val.ideal.mul_mem_right _ hmem
      simpa [f] using hprod_mem
    rw [← hW]
    exact hfW
  refine ⟨f, hfne, hfhom, ?_⟩
  exact le_antisymm hCleSpan hSpanleC

end
