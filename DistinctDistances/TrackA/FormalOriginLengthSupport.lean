import DistinctDistances.TrackA.JacobianLocalizedSpanSupport
import OAI.RingTheory.Multiplicity.SubalgebraStageFromBase

namespace DistinctDistances.TrackA
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
open scoped Classical TensorProduct
open IsLocalRing
open OAI.BoundaryOnly.FormalObstruction.FormalCorrection

variable {K β : Type} [Field K] [Fintype β]

/-- Exact lengths over a local algebra whose residue field is the coefficient field. -/
theorem length_eq_field_of_residue_equiv (R : Type*) [CommRing R]
    [IsLocalRing R] [Algebra K R] (e : ResidueField R ≃ₐ[K] K)
    (M : Type*) [AddCommGroup M] [Module K M] [Module R M]
    [IsScalarTower K R M] : Module.length R M = Module.length K M := by
  have hres : Function.Surjective (algebraMap K (ResidueField R)) := by
    intro a
    refine ⟨e a, e.injective ?_⟩
    simpa only [Algebra.algebraMap_self, RingHom.id_apply] using e.commutes (e a)
  have hres' : Function.Surjective (algebraMap (ResidueField K) (ResidueField R)) := by
    intro a
    obtain ⟨c, hc⟩ := hres a
    refine ⟨residue K c, ?_⟩
    change algebraMap (ResidueField K) (ResidueField R)
      (algebraMap K (ResidueField K) c) = a
    rw [← IsScalarTower.algebraMap_apply, hc]
  have hfactor : Module.length (ResidueField K) (ResidueField R) = 1 := by
    rw [Module.length_eq_of_surjective hres', Module.length_eq_one]
  have hh := IsLocalRing.length_restrictScalars K R M
  rw [hfactor, mul_one] at hh
  exact hh.symm

/-- The residue field of the actual formal ring is its coefficient field. -/
def formalSeriesResidueEquiv : ResidueField (MvPowerSeries β K) ≃ₐ[K] K := by
  let f : MvPowerSeries β K →ₐ[K] K :=
    ⟨MvPowerSeries.constantCoeff, fun c => MvPowerSeries.constantCoeff_C c⟩
  have hker : maximalIdeal (MvPowerSeries β K) = RingHom.ker f.toRingHom := by
    rw [OAI.Lech.PowerSeries.maximalIdeal_eq_variables,
      OAI.Lech.PowerSeries.variables_eq_ker_constantCoeff]
  exact (Ideal.quotientEquivAlgOfEq K hker).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := f)
      (fun c => ⟨MvPowerSeries.C c, MvPowerSeries.constantCoeff_C c⟩))

theorem formalSeries_length_eq_field_length
    (M : Type*) [AddCommGroup M] [Module K M] [Module (MvPowerSeries β K) M]
    [IsScalarTower K (MvPowerSeries β K) M] :
    Module.length (MvPowerSeries β K) M = Module.length K M :=
  length_eq_field_of_residue_equiv _ formalSeriesResidueEquiv M

/-- The literal base-chart point is generated by its original coordinates. -/
theorem formalOrigin_point_eq_vars :
    (AffineEtaleChart.base (K := K) (α := β)).point = MvPolynomial.idealOfVars β K := by
  change RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial β K →+* K) = _
  ext p
  change p.coeff 0 = 0 ↔ p ∈ MvPolynomial.idealOfVars β K
  rw [← pow_one (MvPolynomial.idealOfVars β K), MvPolynomial.mem_pow_idealOfVars_iff']
  constructor
  · intro hp d hd
    have he : d = 0 := (Finsupp.degree_eq_zero_iff d).mp (by omega)
    subst d
    exact hp
  · intro hp
    exact hp 0 (by simp)

/-- The original expansion extends the actual local maximal ideal exactly. -/
theorem formalOrigin_localExpansion_maximalIdeal :
    (maximalIdeal (AffineEtaleChart.base (K := K) (α := β)).LocalRing).map
      (AffineEtaleChart.base (K := K) (α := β)).localExpansion.toRingHom =
      maximalIdeal (MvPowerSeries β K) := by
  let E : AffineEtaleChart K β := .base
  have hc : E.localExpansion.toRingHom.comp (algebraMap E.S E.LocalRing) =
      (MvPolynomial.coeToMvPowerSeries.ringHom : MvPolynomial β K →+* MvPowerSeries β K) := by
    apply RingHom.ext
    intro p
    exact E.localExpansion_map p
  calc
    _ = (E.point.map (algebraMap E.S E.LocalRing)).map E.localExpansion.toRingHom := by
      rw [IsLocalization.AtPrime.map_eq_maximalIdeal E.point E.LocalRing]
    _ = E.point.map MvPolynomial.coeToMvPowerSeries.ringHom := by
      rw [Ideal.map_map, hc]
      rfl
    _ = (MvPolynomial.idealOfVars β K).map MvPolynomial.coeToMvPowerSeries.ringHom :=
      congrArg (Ideal.map MvPolynomial.coeToMvPowerSeries.ringHom) formalOrigin_point_eq_vars
    _ = maximalIdeal (MvPowerSeries β K) := by
      rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp,
        OAI.Lech.PowerSeries.maximalIdeal_eq_variables]
      simp only [Function.comp_def, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
        MvPolynomial.coe_X]

/-- Exact extended lengths under the actual faithfully flat origin expansion. -/
theorem formalOrigin_quotient_length
    (I : Ideal (AffineEtaleChart.base (K := K) (α := β)).LocalRing) :
    Module.length (AffineEtaleChart.base (K := K) (α := β)).LocalRing
      ((AffineEtaleChart.base (K := K) (α := β)).LocalRing ⧸ I) =
    Module.length K (MvPowerSeries β K ⧸ I.map
      (AffineEtaleChart.base (K := K) (α := β)).localExpansion.toRingHom) := by
  let E : AffineEtaleChart K β := .base
  let S := MvPowerSeries β K
  letI : Module.FaithfullyFlat E.LocalRing S := E.localFaithfullyFlat
  have hm : (maximalIdeal E.LocalRing).map (algebraMap E.LocalRing S) =
      maximalIdeal S := formalOrigin_localExpansion_maximalIdeal
  have hsimple : IsSimpleModule S (S ⧸ maximalIdeal S) :=
    isSimpleModule_iff_quot_maximal.mpr
      ⟨maximalIdeal S, inferInstance, ⟨LinearEquiv.refl S _⟩⟩
  have he := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S I).toLinearEquiv.length_eq
  rw [IsLocalRing.length_baseChange E.LocalRing S (E.LocalRing ⧸ I), hm,
    Module.length_eq_one (R := S) (M := S ⧸ maximalIdeal S), mul_one] at he
  exact he.symm.trans (formalSeries_length_eq_field_length _)

end
end DistinctDistances.TrackA
