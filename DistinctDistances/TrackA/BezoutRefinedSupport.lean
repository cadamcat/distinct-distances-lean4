/-!
Multiplicity-free Bézout for a pure family of components, and the dimension
facts it uses. A prime of `ℂ[x₁,…,xₙ]` has Hilbert dimension `n − height`.
Krull's height theorem then forces a component of the first `c` equations to
have dimension at least `n − c`, while a hypersurface cut drops dimension by
at most one. The two bounds meet, and `proper_cut_sum_affineDegree_le` sums
the degrees.
-/

namespace DistinctDistances.TrackA
noncomputable section
open scoped BigOperators Classical
open OAI.QuarticPowerFree OAI.PiExponentJets.W24 OAI.PiExponentSiegel.W23

variable {n : ℕ}

theorem quotient_krullDim_eq_affineDimension (Q : Ideal (Poly n)) [Q.IsPrime] :
    ringKrullDim (Poly n ⧸ Q) = (affineDimension Q : WithBot ℕ∞) := by
  have htr := hilbert_natDegree_eq_trdeg Q (coordinateHilbert Q)
    (coordinateHilbert_eventually Q)
  have hfin : Algebra.FiniteType ℂ (Poly n ⧸ Q) := inferInstance
  have hkrull := finiteType_domain_krullDim_eq_trdeg (k := ℂ) (B := Poly n ⧸ Q)
  have hto : (Algebra.trdeg ℂ (Poly n ⧸ Q)).toNat = affineDimension Q := by
    rw [← htr]
    exact Cardinal.toNat_natCast _
  simpa only [hto] using hkrull

/-- A sum of two natural numbers, seen in `WithBot ℕ∞`, is their natural sum. -/
private theorem nat_of_withBot_add {m a b : ℕ}
    (heq : ((m : ℕ∞) : WithBot ℕ∞) + (a : WithBot ℕ∞) = (b : WithBot ℕ∞)) :
    m + a = b := by
  have hbot : ((m + a : ℕ) : WithBot ℕ∞) = b := by
    rw [← WithBot.coe_natCast, Nat.cast_add, WithBot.coe_add, WithBot.coe_natCast]
    exact heq
  exact WithTop.coe_injective (WithBot.coe_injective hbot)

theorem affineDimension_add_height (Q : Ideal (Poly n)) [Q.IsPrime] :
    (affineDimension Q : ℕ∞) + Q.height = n := by
  have h := fin_polynomial_prime_pair_local_dimension ℂ n (⊥ : Ideal (Poly n)) Q bot_le
  have hbot : parameterLocalizedIdeal (⊥ : Ideal (Poly n)) Q = ⊥ := Ideal.map_bot
  rw [hbot] at h
  have hlocal : ringKrullDim (Localization.AtPrime Q ⧸ (⊥ : Ideal (Localization.AtPrime Q))) =
      ringKrullDim (Localization.AtPrime Q) := by
    with_unfolding_all exact (RingEquiv.quotientBot (Localization.AtPrime Q)).ringKrullDim
  have hpoly : ringKrullDim (Poly n ⧸ (⊥ : Ideal (Poly n))) = ringKrullDim (Poly n) := by
    with_unfolding_all exact (RingEquiv.quotientBot (Poly n)).ringKrullDim
  rw [hlocal, hpoly, IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q),
    quotient_krullDim_eq_affineDimension Q] at h
  have hring : ringKrullDim (Poly n) = (n : WithBot ℕ∞) := by
    simp only [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_natCard, Nat.card_fin, zero_add, WithBot.coe_natCast]
  rw [hring] at h
  have hne : Q.height ≠ ⊤ := by
    intro htop
    rw [htop] at h
    exact ENat.top_ne_natCast n (WithBot.coe_injective h)
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
  have hnat : m + affineDimension Q = n := nat_of_withBot_add (by
    rw [← hm] at h
    exact h)
  rw [← hm, ← Nat.cast_add]
  exact congr_arg (Nat.cast : ℕ → ℕ∞) (add_comm m (affineDimension Q) ▸ hnat)

/-- A minimal prime of an ideal generated by `c` polynomials has height at most `c`. -/
theorem height_le_of_range_component {c : ℕ} (f : Fin c → Poly n) (Y : Ideal (Poly n))
    (hY : Y ∈ (Ideal.span (Set.range f)).minimalPrimes) : Y.height ≤ c := by
  classical
  have hspan : Ideal.span (Set.range f) =
      Ideal.span (↑(Finset.univ.image f) : Set (Poly n)) := by simp
  have hcard : Y.height ≤ (Finset.univ.image f).card :=
    Ideal.height_le_card_of_mem_minimalPrimes_span_finset (by simpa [hspan] using hY)
  have hle : (Finset.univ.image f).card ≤ c := by
    simpa [Fintype.card_fin] using
      (Finset.card_image_le :
        (Finset.univ.image f).card ≤ Finset.card (Finset.univ : Finset (Fin c)))
  exact hcard.trans (by exact_mod_cast hle)

theorem codim_le_affineDimension {c : ℕ} (f : Fin c → Poly n) (Y : Ideal (Poly n))
    (hY : Y ∈ (Ideal.span (Set.range f)).minimalPrimes) :
    n ≤ affineDimension Y + c := by
  have : Y.IsPrime := hY.isPrime
  have hht := height_le_of_range_component f Y hY
  have hsum := affineDimension_add_height Y
  have : (n : ℕ∞) ≤ (affineDimension Y : ℕ∞) + c := by
    calc
      (n : ℕ∞) = (affineDimension Y : ℕ∞) + Y.height := hsum.symm
      _ ≤ (affineDimension Y : ℕ∞) + c := add_le_add_right hht _
  exact_mod_cast this

private theorem le_succ_of_height_add {a b : ℕ} {h : ℕ∞} (hh : h ≤ 1)
    (heq : (h : WithBot ℕ∞) + (a : WithBot ℕ∞) = (b : WithBot ℕ∞)) : b ≤ a + 1 := by
  cases h using WithTop.recTopCoe with
  | top =>
    exact False.elim ((not_le_of_gt (WithTop.coe_lt_top (1 : ℕ))) hh)
  | coe m =>
    have hm : m ≤ 1 := Nat.cast_le.mp hh
    have hsum : m + a = b := nat_of_withBot_add heq
    omega

/-- A component of `Y ∩ Z(g)` has dimension at least `dim Y − 1`. -/
theorem affineDimension_le_succ_of_cut (Y W : Ideal (Poly n)) [Y.IsPrime] [W.IsPrime]
    (g : Poly n) (hW : W ∈ (Y ⊔ Ideal.span {g}).minimalPrimes) :
    affineDimension Y ≤ affineDimension W + 1 := by
  have hYW : Y ≤ W := le_sup_left.trans hW.le
  have hpair := polynomial_prime_pair_dimension ℂ (Fin n) Y W hYW
  have hht : (W.map (Ideal.Quotient.mk Y)).height ≤ 1 :=
    Ideal.map_height_le_one_of_mem_minimalPrimes hW
  rw [quotient_krullDim_eq_affineDimension W, quotient_krullDim_eq_affineDimension Y] at hpair
  exact le_succ_of_height_add hht hpair

theorem span_range_fin_succ {c : ℕ} (f : Fin (c + 1) → Poly n) :
    Ideal.span (Set.range f) =
      Ideal.span (Set.range (fun i : Fin c => f i.castSucc)) ⊔
        Ideal.span {f (Fin.last c)} := by
  have hr : Set.range f =
      insert (f (Fin.last c)) (Set.range (fun i : Fin c => f i.castSucc)) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
      · exact Or.inr ⟨j, rfl⟩
      · exact Or.inl rfl
    · rintro (rfl | ⟨i, rfl⟩)
      · exact ⟨Fin.last c, rfl⟩
      · exact ⟨i.castSucc, rfl⟩
  rw [hr, Ideal.span_insert, sup_comm]

theorem whole_degree (n : ℕ) : (AffineVariety.whole : AffineVariety n).degree = 1 := by
  have hp : (AffineVariety.whole : AffineVariety n).hilbertPolynomial =
      Polynomial.preHilbertPoly ℚ n 0 := by
    apply polynomial_eq_of_eventually_nat_eval_eq
    filter_upwards [(AffineVariety.whole : AffineVariety n).hilbert_eventually] with D hD
    rw [← hD, Polynomial.preHilbertPoly_eq_choose_add_sub ℚ n (Nat.zero_le (D + n))]
    simp only [Nat.sub_zero]
    congr 1
    let H := totalSpace (σ := Fin n) (K := ℂ) D
    let _ := totalSpace_finite (n := n) (K := ℂ) D
    let q : H →ₗ[ℂ] (Poly n ⧸ (⊥ : Ideal (Poly n))) :=
      (Ideal.Quotient.mkₐ ℂ ⊥).toLinearMap.comp H.subtype
    have hker : LinearMap.ker q = ⊥ := by
      ext f
      change Ideal.Quotient.mk ⊥ f.val = 0 ↔ f = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      simp
    have hrange : LinearMap.range q = H.map (Ideal.Quotient.mkₐ ℂ ⊥).toLinearMap := by
      rw [LinearMap.range_comp, Submodule.range_subtype]
    have h := q.finrank_range_add_finrank_ker
    rw [hker, finrank_bot, add_zero, hrange] at h
    have hi : (AffineVariety.whole : AffineVariety n).ideal = ⊥ :=
      Ideal.radical_bot_of_isReduced
    change Module.finrank ℂ ((totalSpace D).map
      (Ideal.Quotient.mkₐ ℂ (AffineVariety.whole : AffineVariety n).ideal).toLinearMap) = _
    rw [hi]
    exact h.trans (totalSpace_finrank D)
  change ((AffineVariety.whole : AffineVariety n).hilbertPolynomial.natDegree.factorial : ℚ) *
      (AffineVariety.whole : AffineVariety n).hilbertPolynomial.coeff
        (AffineVariety.whole : AffineVariety n).hilbertPolynomial.natDegree = 1
  rw [hp, Polynomial.natDegree_preHilbertPoly, Polynomial.coeff_preHilbertPoly_self]
  exact mul_inv_cancel₀ (by exact_mod_cast Nat.factorial_ne_zero n)

theorem components_core (n : ℕ) :
    ∀ c (_hc : c ≤ n) (f : Fin c → Poly n)
      (_hdegree : ∀ i, 1 ≤ (f i).totalDegree) (F : AffineFamily.Family n)
      (_hF : AffineFamily.IsPure F (n - c))
      (_hcomponents : ∀ V ∈ F, V.IsComponentOf (Ideal.span (Set.range f))),
      (∑ V ∈ F, V.degree) ≤ ∏ i, ((f i).totalDegree : ℚ) := by
  classical
  intro c
  induction c with
  | zero =>
    intro _hc f _hdegree F _hF hcomponents
    have hbot : Ideal.span (Set.range f) = ⊥ := by
      simp
    have hwhole : (AffineVariety.whole : AffineVariety n).ideal = ⊥ :=
      Ideal.radical_bot_of_isReduced
    have honly : ∀ V ∈ F, V = AffineVariety.whole := by
      intro V hV
      apply AffineVariety.ext
      have hmem : V.ideal ∈ (⊥ : Ideal (Poly n)).minimalPrimes := by
        rw [← hbot]
        exact hcomponents V hV
      have hid : V.ideal = ⊥ := by
        rw [Ideal.minimalPrimes_eq_subsingleton_self] at hmem
        simpa using hmem
      rw [hid, hwhole]
    have hdeg := whole_degree n
    by_cases hmem : (AffineVariety.whole : AffineVariety n) ∈ F
    · have hFeq : F = {(AffineVariety.whole : AffineVariety n)} :=
        Finset.eq_singleton_iff_unique_mem.mpr ⟨hmem, fun V hV => honly V hV⟩
      simp [hFeq, hdeg]
    · have hemp : F = ∅ := by
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro V hV
        exact hmem ((honly V hV) ▸ hV)
      simp [hemp]
  | succ c ih =>
    intro hc f hdegree F hF hcomponents
    let f' : Fin c → Poly n := fun i => f i.castSucc
    let g : Poly n := f (Fin.last c)
    have hspan := span_range_fin_succ f
    let I' : Ideal (Poly n) := Ideal.span (Set.range f')
    have hdegree' : ∀ i, 1 ≤ (f' i).totalDegree := fun i => hdegree i.castSucc
    have hparent (V : AffineVariety n) (hV : V ∈ F) :
        ∃ P : Ideal (Poly n), P ∈ I'.minimalPrimes ∧ P ≤ V.ideal := by
      have hI' : I' ≤ Ideal.span (Set.range f) := by
        rw [hspan]
        exact le_sup_left
      have : V.ideal.IsPrime := (hF V hV).1
      exact Ideal.exists_minimalPrimes_le (hI'.trans (hcomponents V hV).le)
    let parentOf : AffineVariety n → AffineVariety n := fun V =>
      if hV : V ∈ F then
        ⟨Classical.choose (hparent V hV),
          (Classical.choose_spec (hparent V hV)).1.isPrime.isRadical⟩
      else
        AffineVariety.whole
    have hparentSpec (V : AffineVariety n) (hV : V ∈ F) :
        (parentOf V).ideal ∈ I'.minimalPrimes ∧ (parentOf V).ideal ≤ V.ideal := by
      dsimp only [parentOf]
      rw [dite_eq_left hV]
      exact Classical.choose_spec (hparent V hV)
    have hcut (V : AffineVariety n) (hV : V ∈ F) :
        V.ideal ∈ ((parentOf V).ideal ⊔ Ideal.span {g}).minimalPrimes := by
      have hYle : (parentOf V).ideal ≤ V.ideal := (hparentSpec V hV).2
      have hgW : g ∈ V.ideal := by
        apply (hcomponents V hV).le
        rw [hspan]
        exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self g)
      have hsup : (parentOf V).ideal ⊔ Ideal.span {g} ≤ V.ideal :=
        sup_le hYle (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hgW))
      have hpre : Ideal.span (Set.range f) ≤ (parentOf V).ideal ⊔ Ideal.span {g} := by
        rw [hspan]
        exact sup_le_sup (hparentSpec V hV).1.le le_rfl
      refine ⟨⟨(hF V hV).1, hsup⟩, ?_⟩
      intro J hJ hJW
      exact (hcomponents V hV).2 ⟨hJ.1, hpre.trans hJ.2⟩ hJW
    have hparentDim (V : AffineVariety n) (hV : V ∈ F) :
        (parentOf V).dimension = n - c := by
      let Y := (parentOf V).ideal
      have : Y.IsPrime := (hparentSpec V hV).1.isPrime
      have : V.ideal.IsPrime := (hF V hV).1
      have hlow := codim_le_affineDimension f' Y (hparentSpec V hV).1
      have hup := affineDimension_le_succ_of_cut Y V.ideal g (hcut V hV)
      have hW : affineDimension V.ideal = n - (c + 1) := (hF V hV).2
      have hY : affineDimension Y = n - c := by omega
      simpa [Y, AffineVariety.dimension] using hY
    have hgNot (V : AffineVariety n) (hV : V ∈ F) : g ∉ (parentOf V).ideal := by
      intro hg
      have hsupY : (parentOf V).ideal ⊔ Ideal.span {g} = (parentOf V).ideal := by
        rw [sup_eq_left]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hg)
      have hWeq : V.ideal = (parentOf V).ideal := by
        have hmin : V.ideal ∈ (parentOf V).ideal.minimalPrimes := by
          rw [← hsupY]
          exact hcut V hV
        have : (parentOf V).ideal.IsPrime := (hparentSpec V hV).1.isPrime
        rw [Ideal.minimalPrimes_eq_subsingleton_self] at hmin
        simpa using hmin
      have hdimV : V.dimension = n - (c + 1) := (hF V hV).2
      have hdimY : (parentOf V).dimension = n - c := hparentDim V hV
      have hsame : V.dimension = (parentOf V).dimension := by
        change affineDimension V.ideal = affineDimension (parentOf V).ideal
        rw [hWeq]
      omega
    let parents : AffineFamily.Family n := F.image parentOf
    have hparentMem (V : AffineVariety n) (hV : V ∈ F) : parentOf V ∈ parents :=
      Finset.mem_image.mpr ⟨V, hV, rfl⟩
    have hIH : (∑ Y ∈ parents, Y.degree) ≤ ∏ i : Fin c, ((f' i).totalDegree : ℚ) :=
      ih (by omega : c ≤ n) f' hdegree' parents
        (by
          intro Y hY
          obtain ⟨V, hV, rfl⟩ := Finset.mem_image.mp hY
          exact ⟨(hparentSpec V hV).1.isPrime, hparentDim V hV⟩)
        (by
          intro Y hY
          obtain ⟨V, hV, rfl⟩ := Finset.mem_image.mp hY
          exact (hparentSpec V hV).1)
    have hbound (Y : AffineVariety n) (hY : Y ∈ parents) :
        (∑ W ∈ F with parentOf W = Y, W.degree) ≤ (g.totalDegree : ℚ) * Y.degree := by
      obtain ⟨V, hV, rfl⟩ := Finset.mem_image.mp hY
      let children : AffineFamily.Family n := F.filter (fun W => parentOf W = parentOf V)
      have hch : ∀ W ∈ children,
          W.IsComponentOf ((parentOf V).ideal ⊔ Ideal.span {g}) := by
        intro W hW
        have hWF : W ∈ F := (Finset.mem_filter.mp hW).1
        have hpar : parentOf W = parentOf V := (Finset.mem_filter.mp hW).2
        change W.ideal ∈ ((parentOf V).ideal ⊔ Ideal.span {g}).minimalPrimes
        rw [← hpar]
        exact hcut W hWF
      have : (parentOf V).ideal.IsPrime := (hparentSpec V hV).1.isPrime
      have hQ : ∀ W : children, W.val.ideal ∈
          ((parentOf V).ideal ⊔ Ideal.span {g}).minimalPrimes := fun W =>
        hch W.val W.property
      have hQi : Function.Injective (fun W : children => W.val.ideal) := by
        intro W₁ W₂ h
        exact Subtype.ext (AffineVariety.ext h)
      have hdimCut : affineDimension (parentOf V).ideal = (n - (c + 1)) + 1 := by
        rw [show affineDimension (parentOf V).ideal = (parentOf V).dimension from rfl,
          hparentDim V hV]
        omega
      have hdegreeCut := proper_cut_sum_affineDegree_le (parentOf V).ideal g
        (hgNot V hV) hdimCut (fun W : children => W.val.ideal) hQ hQi
      have hsumAttach : (∑ W ∈ children, affineDegree W.ideal) =
          ∑ W : children, affineDegree W.val.ideal := by
        rw [Finset.univ_eq_attach]
        exact (Finset.sum_attach children _).symm
      have hchildren : AffineFamily.degree children ≤
          (g.totalDegree : ℚ) * (parentOf V).degree := by
        simpa only [AffineFamily.degree, AffineVariety.degree] using hsumAttach.trans_le hdegreeCut
      simpa [children, AffineFamily.degree] using hchildren
    have hfiber := Finset.sum_fiberwise_of_maps_to (s := F) (t := parents) (g := parentOf)
      (f := fun V => V.degree) (fun V hV => hparentMem V hV)
    calc
      (∑ V ∈ F, V.degree) =
          ∑ Y ∈ parents, ∑ W ∈ F with parentOf W = Y, W.degree := hfiber.symm
      _ ≤ ∑ Y ∈ parents, (g.totalDegree : ℚ) * Y.degree :=
        Finset.sum_le_sum fun Y hY => hbound Y hY
      _ = (g.totalDegree : ℚ) * ∑ Y ∈ parents, Y.degree := by rw [Finset.mul_sum]
      _ ≤ (g.totalDegree : ℚ) * ∏ i : Fin c, ((f' i).totalDegree : ℚ) :=
        mul_le_mul_of_nonneg_left hIH (Nat.cast_nonneg _)
      _ = ∏ i, ((f i).totalDegree : ℚ) := by
        rw [mul_comm]
        simpa [f', g] using
          (Fin.prod_univ_castSucc (fun i => ((f i).totalDegree : ℚ))).symm

/-- A field has unique factorization: every nonzero element is a unit, so the empty
product is its only factorization. -/
private theorem field_uniqueFactorizationMonoid (K : Type*) [Field K] :
    UniqueFactorizationMonoid K :=
  UniqueFactorizationMonoid.of_exists_prime_factors fun a ha =>
    ⟨0, by simp, by
      simpa using (associated_one_iff_isUnit.mpr (isUnit_iff_ne_zero.mpr ha)).symm⟩

/-- In `WithBot ℕ∞`, `a + 1 = n + 1` forces `a = n`. -/
private theorem withBot_eq_of_add_one {a : WithBot ℕ∞} {n : ℕ}
    (h : a + 1 = (n + 1 : ℕ)) : a = n := by
  have hbot : a ≠ ⊥ := by
    intro hb
    rw [hb, WithBot.bot_add] at h
    exact WithBot.bot_ne_coe h
  obtain ⟨m, hm⟩ := WithBot.ne_bot_iff_exists.mp hbot
  have htop : m ≠ ⊤ := by
    intro ht
    rw [← hm, ht] at h
    have hcoe : ((⊤ + (1 : ℕ∞) : ℕ∞) : WithBot ℕ∞) = ((n + 1 : ℕ) : WithBot ℕ∞) := by
      simpa [← WithBot.coe_add, WithBot.coe_one] using h
    exact ENat.top_ne_natCast (n + 1)
      (WithBot.coe_injective (by simpa [WithTop.top_add] using hcoe))
  obtain ⟨t, ht⟩ := ENat.ne_top_iff_exists.mp htop
  have hnat : t + 1 = n + 1 := nat_of_withBot_add (by
    rw [← hm, ← ht] at h
    simpa [WithBot.coe_natCast] using h)
  have htn : t = n := by omega
  rw [← hm, ← ht, htn, WithBot.coe_natCast]

private theorem colon_singleton_eq_span_cofactor
    {R : Type*} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]
    {f g : R} (hf : f ≠ 0) :
    ∃ f', (Ideal.span {f}).colon {g} = Ideal.span {f'} := by
  let _ : GCDMonoid R := UniqueFactorizationMonoid.toGCDMonoid R
  let d := gcd f g
  have hdvd : d ∣ f := gcd_dvd_left f g
  obtain ⟨f', hf'⟩ := hdvd
  refine ⟨f', ?_⟩
  have hgcd : d ≠ 0 := by
    intro h0
    exact hf ((gcd_eq_zero_iff f g).mp (by simpa [d] using h0)).1
  ext r
  rw [Ideal.mem_span_singleton, Submodule.mem_colon_singleton, smul_eq_mul,
    Ideal.mem_span_singleton]
  rw [← dvd_mul_gcd_iff_dvd_mul]
  conv_lhs => arg 1; rw [hf']
  rw [mul_comm r d, mul_dvd_mul_iff_left hgcd]

/-- A prime colon of a nonzero principal ideal in a Noetherian UFD has height at most one. -/
private theorem prime_colon_height_le_one
    {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R]
    {f : R} (hf : f ≠ 0) (P : Ideal R) [P.IsPrime]
    (hP : ∃ g, P = (Ideal.span {f}).colon {g}) : P.height ≤ 1 := by
  obtain ⟨g, hg⟩ := hP
  obtain ⟨f', hf'⟩ := colon_singleton_eq_span_cofactor (f := f) (g := g) hf
  have heq : P = Ideal.span {f'} := hg.trans hf'
  have hunit : ¬ IsUnit f' := by
    intro hu
    have htop : P = ⊤ := by
      rw [heq, Ideal.span_singleton_eq_top.mpr hu]
    exact (inferInstance : P.IsPrime).ne_top htop
  rw [heq]
  exact Ideal.height_span_singleton_le_one hunit

private theorem associated_eq_colon_singleton
    {R : Type*} [CommRing R] [IsNoetherianRing R] {J P : Ideal R}
    (hP : IsAssociatedPrime P (R ⧸ J)) : ∃ g, P = J.colon {g} := by
  obtain ⟨x, hx⟩ := (isAssociatedPrime_iff.mp hP).2
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨g, ?_⟩
  ext r
  rw [hx, Submodule.mem_colon_singleton, Submodule.mem_bot, Submodule.mem_colon_singleton,
    smul_eq_mul]
  have hsmul : r • Ideal.Quotient.mk J g = Ideal.Quotient.mk J (r * g) := by
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    exact (map_mul (Ideal.Quotient.mk J) r g).symm
  rw [hsmul, Ideal.Quotient.eq_zero_iff_mem]

/-- The maximal ideal of a local Noetherian UFD of dimension 2 is not associated to `R/(f)`. -/
private theorem maximal_not_associated_principal
    {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R]
    [IsLocalRing R] (hht : (IsLocalRing.maximalIdeal R).height = 2) {f : R} (hf : f ≠ 0) :
    ¬ IsAssociatedPrime (IsLocalRing.maximalIdeal R) (R ⧸ Ideal.span {f}) := by
  intro hAss
  have hle := prime_colon_height_le_one hf (IsLocalRing.maximalIdeal R)
    (associated_eq_colon_singleton hAss)
  have htwo : (2 : ℕ∞) ≤ 1 := by
    rw [← hht]
    exact hle
  have : (2 : ℕ) ≤ 1 := Nat.cast_le.mp htwo
  omega

theorem whole_dimension (n : ℕ) : (AffineVariety.whole (n := n)).dimension = n := by
  have hid : (AffineVariety.whole (n := n)).ideal = ⊥ := Ideal.radical_bot_of_isReduced
  have h := affineDimension_add_height (Q := (⊥ : Ideal (Poly n)))
  rw [Ideal.height_bot, add_zero] at h
  have hdim : affineDimension (⊥ : Ideal (Poly n)) = n := Nat.cast_injective h
  simpa [AffineVariety.dimension, hid] using hdim

theorem ne_zero_of_one_le_totalDegree {p : Poly n} (hp : 1 ≤ p.totalDegree) : p ≠ 0 := by
  intro h0
  rw [h0, MvPolynomial.totalDegree_zero] at hp
  omega

theorem span_fin_two (f : Fin 2 → Poly n) :
    Ideal.span (Set.range f) = Ideal.span {f 0} ⊔ Ideal.span {f 1} := by
  have hr : Set.range f = insert (f 0) {f 1} := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · intro hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  rw [hr, Ideal.span_insert]

theorem height_eq_two_of_affineDimension {Q : Ideal (Poly n)} [Q.IsPrime]
    (hn : 2 ≤ n) (hdim : affineDimension Q = n - 2) : Q.height = 2 := by
  have hsum := affineDimension_add_height Q
  rw [hdim] at hsum
  have hne : Q.height ≠ ⊤ := by
    intro ht
    rw [ht, add_top] at hsum
    exact ENat.top_ne_natCast n hsum
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
  rw [← hm, ← Nat.cast_add] at hsum
  have hnat : n - 2 + m = n := Nat.cast_injective hsum
  have hm2 : m = 2 := by omega
  rw [← hm]
  exact (congr_arg (Nat.cast : ℕ → ℕ∞) hm2).trans Nat.cast_ofNat

theorem hypersurface_component_dimension {P : Ideal (Poly n)} {f : Poly n}
    (hf : f ≠ 0) (hP : P ∈ (Ideal.span {f}).minimalPrimes) :
    affineDimension P = n - 1 := by
  have : P.IsPrime := hP.isPrime
  have hle : P.height ≤ 1 :=
    Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {f}) P hP
  have hne0 : P.height ≠ 0 := by
    intro h0
    have hbot := (Ideal.height_eq_zero_iff_eq_bot (I := P)).mp h0
    have hfP : f ∈ P := hP.1.2 (Ideal.mem_span_singleton_self f)
    rw [hbot, Ideal.mem_bot] at hfP
    exact hf hfP
  have hht : P.height = 1 := by
    obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := P))
    rw [← hm] at hle hne0
    have hmle : m ≤ 1 := Nat.cast_le.mp hle
    have hmne : m ≠ 0 := by
      intro hz
      exact hne0 (by rw [hz, Nat.cast_zero])
    have hm1 : m = 1 := by omega
    rw [← hm]
    exact (congr_arg (Nat.cast : ℕ → ℕ∞) hm1).trans Nat.cast_one
  have hsum := affineDimension_add_height P
  rw [hht] at hsum
  have hnat : affineDimension P + 1 = n := Nat.cast_injective (by
    rw [← hsum, Nat.cast_add, Nat.cast_one])
  omega

private theorem localization_at_prime_ufm {Q : Ideal (Poly n)} [Q.IsPrime] :
    UniqueFactorizationMonoid (Localization.AtPrime Q) := by
  let _ : UniqueFactorizationMonoid ℂ := field_uniqueFactorizationMonoid ℂ
  infer_instance

theorem quotient_krullDim_span_singleton_eq_one {Q : Ideal (Poly n)} [Q.IsPrime]
    (hht : Q.height = 2) {f : Poly n} (hf : f ≠ 0) (hfQ : f ∈ Q) :
    ringKrullDim (Localization.AtPrime Q ⧸
      Ideal.span {algebraMap (Poly n) (Localization.AtPrime Q) f}) = 1 := by
  let R := Localization.AtPrime Q
  let a := algebraMap (Poly n) R f
  have hinj := IsLocalization.injective (S := R) (M := Q.primeCompl)
    Q.primeCompl_le_nonZeroDivisors
  have ha0 : a ≠ 0 := by
    intro h0
    exact hf (hinj (h0.trans (RingHom.map_zero (algebraMap (Poly n) R)).symm))
  have haReg : a ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero ha0
  have haMax : a ∈ IsLocalRing.maximalIdeal R :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R Q f).mpr hfQ
  have hdrop := Module.ringKrullDim_quotient_add_one_of_mem_nonZeroDivisors (r := a) haReg
    (p := IsLocalRing.maximalIdeal R) IsLocalRing.maximalIdeal_height_eq_ringKrullDim haMax
  have hdropRaw : ringKrullDim (R ⧸ Ideal.span {a}) + 1 = ((2 : ℕ) : WithBot ℕ∞) := by
    rw [hdrop, IsLocalization.AtPrime.ringKrullDim_eq_height Q R, hht]
    exact WithBot.coe_natCast 2
  have hdrop' : ringKrullDim (R ⧸ Ideal.span {a}) + 1 = (1 + 1 : ℕ) := by
    rw [hdropRaw]
  exact withBot_eq_of_add_one hdrop'

theorem maximal_not_associated_span_singleton {Q : Ideal (Poly n)} [Q.IsPrime]
    (hht : Q.height = 2) {f : Poly n} (hf : f ≠ 0) :
    ¬ IsAssociatedPrime (IsLocalRing.maximalIdeal (Localization.AtPrime Q))
        (Localization.AtPrime Q ⧸
          Ideal.span {algebraMap (Poly n) (Localization.AtPrime Q) f}) := by
  let R := Localization.AtPrime Q
  let a := algebraMap (Poly n) R f
  have hinj := IsLocalization.injective (S := R) (M := Q.primeCompl)
    Q.primeCompl_le_nonZeroDivisors
  have ha0 : a ≠ 0 := by
    intro h0
    exact hf (hinj (h0.trans (RingHom.map_zero (algebraMap (Poly n) R)).symm))
  let _ : UniqueFactorizationMonoid R := localization_at_prime_ufm (Q := Q)
  have hhtM : (IsLocalRing.maximalIdeal R).height = 2 := by
    apply WithBot.coe_injective
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      IsLocalization.AtPrime.ringKrullDim_eq_height Q R, hht]
  exact maximal_not_associated_principal hhtM ha0

theorem quotientMul_second_injective {Q : Ideal (Poly n)} [Q.IsPrime] (f1 f2 : Poly n)
    (hmin : Q ∈ (Ideal.span {f1} ⊔ Ideal.span {f2}).minimalPrimes)
    (hht : Q.height = 2) (hf1 : f1 ≠ 0) :
    Function.Injective
      (OAI.PiExponentJets.W28.LocalIntersection.quotientMul
        ((Ideal.span {f1}).map (algebraMap (Poly n) (Localization.AtPrime Q)))
        (algebraMap (Poly n) (Localization.AtPrime Q) f2)) := by
  let R := Localization.AtPrime Q
  let a1 := algebraMap (Poly n) R f1
  let a2 := algebraMap (Poly n) R f2
  let J := Ideal.span {a1}
  have hmap : (Ideal.span {f1}).map (algebraMap (Poly n) R) = J := by
    rw [Ideal.map_span, Set.image_singleton]
  have hreg : IsSMulRegular (R ⧸ J) a2 := by
    refine OAI.PiExponentSiegel.W58.isSMulRegular_of_avoids_associatedPrimes (R ⧸ J) a2 ?_
    intro P hP ha2
    obtain ⟨g, hg⟩ := associated_eq_colon_singleton hP
    have hJle : J ≤ P := by
      rw [hg]
      exact Ideal.le_colon
    have ha1 : a1 ∈ P := hJle (Ideal.mem_span_singleton_self a1)
    have hleMax : P ≤ IsLocalRing.maximalIdeal R :=
      IsLocalRing.le_maximalIdeal hP.isPrime.ne_top
    have hleQ : P.under (Poly n) ≤ Q := by
      intro x hx
      have hxP : algebraMap (Poly n) R x ∈ P := by
        simpa only [Ideal.mem_under] using hx
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R Q x).mp (hleMax hxP)
    have hspan : Ideal.span {f1} ⊔ Ideal.span {f2} ≤ P.under (Poly n) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_under]
        exact ha1
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_under]
        exact ha2
    have hprime : (P.under (Poly n)).IsPrime :=
      Ideal.IsPrime.under (A := Poly n) (hP := hP.isPrime)
    have hunder : P.under (Poly n) = Q :=
      le_antisymm hleQ (hmin.2 ⟨hprime, hspan⟩ hleQ)
    have hPeq : P = IsLocalRing.maximalIdeal R := by
      have hmapP := IsLocalization.map_under Q.primeCompl R P
      have hmapMax :=
        IsLocalization.map_under Q.primeCompl R (IsLocalRing.maximalIdeal R)
      rw [← hmapP, ← hmapMax, hunder, IsLocalization.AtPrime.under_maximalIdeal R Q]
    exact maximal_not_associated_span_singleton hht hf1 (hPeq ▸ hP)
  rw [hmap]
  intro y z hyz
  rw [OAI.PiExponentJets.W28.LocalIntersection.quotientMul_apply,
    OAI.PiExponentJets.W28.LocalIntersection.quotientMul_apply] at hyz
  exact hreg hyz

theorem two_local_length_eq {Q : Ideal (Poly n)} [Q.IsPrime] (f1 f2 : Poly n)
    (hmin : Q ∈ (Ideal.span {f1} ⊔ Ideal.span {f2}).minimalPrimes)
    (hht : Q.height = 2) (hf1 : f1 ≠ 0) :
    Module.length (Localization.AtPrime Q)
      (Localization.AtPrime Q ⧸ (Ideal.span {f1} ⊔ Ideal.span {f2}).map
        (algebraMap (Poly n) (Localization.AtPrime Q))) =
      OAI.PiExponentJets.W22.globalParentCutSum (Ideal.span {f1}) Q f2 := by
  have hf1Q : f1 ∈ Q := hmin.le (Ideal.mem_sup_left (Ideal.mem_span_singleton_self f1))
  have hdim : ringKrullDim (Localization.AtPrime Q ⧸
      (Ideal.span {f1}).map (algebraMap (Poly n) (Localization.AtPrime Q))) = 1 := by
    rw [Ideal.map_span, Set.image_singleton]
    exact quotient_krullDim_span_singleton_eq_one hht hf1 hf1Q
  have hreg := quotientMul_second_injective f1 f2 hmin hht hf1
  exact OAI.PiExponentJets.W22.localized_onecut_parent_recurrence
    (Ideal.span {f1}) Q f2 hdim hreg

private theorem enat_mul_ne_top {a b : ℕ∞} (ha : a ≠ ⊤) (hb : b ≠ ⊤) : a * b ≠ ⊤ := by
  obtain ⟨na, hna⟩ := ENat.ne_top_iff_exists.mp ha
  obtain ⟨nb, hnb⟩ := ENat.ne_top_iff_exists.mp hb
  rw [← hna, ← hnb, ← Nat.cast_mul]
  exact ENat.natCast_ne_top _

private theorem sum_ne_top {ι : Type*} (s : Finset ι) (a : ι → ℕ∞)
    (ha : ∀ i ∈ s, a i ≠ ⊤) : ∑ i ∈ s, a i ≠ ⊤ := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact WithTop.add_ne_top.mpr ⟨ha i (Finset.mem_insert_self i s),
      ih fun j hj => ha j (Finset.mem_insert_of_mem hj)⟩

private theorem toNat_sum {ι : Type*} (s : Finset ι) (a : ι → ℕ∞)
    (ha : ∀ i ∈ s, a i ≠ ⊤) : (∑ i ∈ s, a i).toNat = ∑ i ∈ s, (a i).toNat := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi,
      ENat.toNat_add (ha i (Finset.mem_insert_self i s))
        (sum_ne_top s a fun j hj => ha j (Finset.mem_insert_of_mem hj)),
      ih fun j hj => ha j (Finset.mem_insert_of_mem hj)]

/-- Multiplicities for a pure family of components of two equations. -/
theorem refined_two_core (hn : 2 ≤ n) (f : Fin 2 → Poly n)
    (hdegree : ∀ i, 1 ≤ (f i).totalDegree) (F : AffineFamily.Family n)
    (hF : AffineFamily.IsPure F (n - 2))
    (hcomponents : ∀ V ∈ F, V.IsComponentOf (Ideal.span (Set.range f))) :
    ∃ m : AffineVariety n → ℕ,
      (∀ V ∈ F, ∀ hV : V.IsIrreducible,
        componentLength (Ideal.span (Set.range f)) V hV = (m V : ℕ∞)) ∧
      (∑ V ∈ F, (m V : ℚ) * V.degree) ≤ ∏ i, ((f i).totalDegree : ℚ) := by
  classical
  let f1 : Poly n := f 0
  let f2 : Poly n := f 1
  have hf1 : f1 ≠ 0 := ne_zero_of_one_le_totalDegree (hdegree 0)
  have hf2 : f2 ≠ 0 := ne_zero_of_one_le_totalDegree (hdegree 1)
  have hspan : Ideal.span (Set.range f) = Ideal.span {f1} ⊔ Ideal.span {f2} := by
    simpa [f1, f2] using span_fin_two f
  let I1 : Ideal (Poly n) := Ideal.span {f1}
  let I2 : Ideal (Poly n) := Ideal.span {f1} ⊔ Ideal.span {f2}
  have hwholeBot : (AffineVariety.whole (n := n)).ideal = ⊥ := Ideal.radical_bot_of_isReduced
  let m : AffineVariety n → ℕ := fun V =>
    if hV : V ∈ F then
      (componentLength (Ideal.span (Set.range f)) V (hF V hV).1).toNat
    else 0
  let plen : (P : Ideal (Poly n)) → P ∈ I1.minimalPrimes → ℕ∞ := fun P hP =>
    let _ : P.IsPrime := hP.isPrime
    Module.length (Localization.AtPrime P)
      (Localization.AtPrime P ⧸ I1.map (algebraMap (Poly n) (Localization.AtPrime P)))
  let clen : (Q : Ideal (Poly n)) → Q.IsPrime → Ideal (Poly n) → ℕ∞ := fun Q hQ P =>
    let _ : Q.IsPrime := hQ
    Module.length (Localization.AtPrime Q)
      (Localization.AtPrime Q ⧸ (P ⊔ Ideal.span {f2}).map
        (algebraMap (Poly n) (Localization.AtPrime Q)))
  have hplen_fin (P : Ideal (Poly n)) (hP : P ∈ I1.minimalPrimes) : plen P hP ≠ ⊤ := by
    let _ : P.IsPrime := hP.isPrime
    have hfl := OAI.PiExponentJets.W22.finiteLength_localized_minimal_quotient I1 P hP
    simpa [plen] using (Module.length_ne_top_iff).mpr hfl
  refine ⟨m, ?_, ?_⟩
  · intro V hVF hV
    have : V.ideal.IsPrime := hV
    have hmem : V.ideal ∈ (Ideal.span (Set.range f)).minimalPrimes := hcomponents V hVF
    have hfl := OAI.PiExponentJets.W22.finiteLength_localized_minimal_quotient
      (Ideal.span (Set.range f)) V.ideal hmem
    have hne : componentLength (Ideal.span (Set.range f)) V hV ≠ ⊤ := by
      simpa [componentLength] using (Module.length_ne_top_iff).mpr hfl
    simp only [m]
    rw [dite_eq_left hVF]
    exact (ENat.natCast_toNat hne).symm
  · have hlen (V : AffineVariety n) (hV : V ∈ F) :
        componentLength (Ideal.span (Set.range f)) V (hF V hV).1 =
          @OAI.PiExponentJets.W22.globalParentCutSum (Poly n) _ _ I1 V.ideal
            (hF V hV).1 f2 := by
      have : V.ideal.IsPrime := (hF V hV).1
      have hmin : V.ideal ∈ (Ideal.span {f1} ⊔ Ideal.span {f2}).minimalPrimes := by
        simpa [AffineVariety.IsComponentOf, hspan] using hcomponents V hV
      have hht : V.ideal.height = 2 := height_eq_two_of_affineDimension hn (hF V hV).2
      have hlenEq := two_local_length_eq (Q := V.ideal) f1 f2 hmin hht hf1
      rw [← hspan] at hlenEq
      simpa [componentLength, I1] using hlenEq
    have hchild_min (V : AffineVariety n) (hV : V ∈ F) {P : Ideal (Poly n)}
        (hP : P ∈ I1.minimalPrimes) (hle : P ≤ V.ideal) :
        V.ideal ∈ (P ⊔ Ideal.span {f2}).minimalPrimes := by
      have hPprime : P.IsPrime := hP.isPrime
      have hf2V : f2 ∈ V.ideal := by
        apply (hcomponents V hV).le
        rw [hspan]
        exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self f2)
      have hsup : P ⊔ Ideal.span {f2} ≤ V.ideal :=
        sup_le hle (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hf2V))
      refine ⟨⟨(hF V hV).1, hsup⟩, ?_⟩
      intro J hJ hJV
      have hI2 : Ideal.span (Set.range f) ≤ J := by
        rw [hspan]
        refine sup_le ?_ ?_
        · exact le_trans hP.le (le_trans (le_sup_left : P ≤ P ⊔ Ideal.span {f2}) hJ.2)
        · exact le_trans le_sup_right hJ.2
      exact (hcomponents V hV).2 ⟨hJ.1, hI2⟩ hJV
    have hclen_fin (V : AffineVariety n) (hV : V ∈ F) {P : Ideal (Poly n)}
        (hP : P ∈ I1.minimalPrimes) (hle : P ≤ V.ideal) :
        clen V.ideal (hF V hV).1 P ≠ ⊤ := by
      have : V.ideal.IsPrime := (hF V hV).1
      have hmin := hchild_min V hV hP hle
      have hfl := OAI.PiExponentJets.W22.finiteLength_localized_minimal_quotient
        (P ⊔ Ideal.span {f2}) V.ideal hmin
      simpa [clen] using (Module.length_ne_top_iff).mpr hfl
    have hm_sum (V : AffineVariety n) (hV : V ∈ F) :
        m V = ∑ P : OAI.PiExponentJets.W22.MinimalParentsBelow I1 V.ideal,
          (plen P.val P.property.1).toNat * (clen V.ideal (hF V hV).1 P.val).toNat := by
      have hprod : ∀ P : OAI.PiExponentJets.W22.MinimalParentsBelow I1 V.ideal,
          plen P.val P.property.1 * clen V.ideal (hF V hV).1 P.val ≠ ⊤ := by
        intro P
        exact enat_mul_ne_top (hplen_fin P.val P.property.1)
          (hclen_fin V hV P.property.1 P.property.2)
      simp only [m]
      rw [dite_eq_left hV, hlen V hV]
      unfold OAI.PiExponentJets.W22.globalParentCutSum
      have : V.ideal.IsPrime := (hF V hV).1
      have hrewrite :
          (∑ P : OAI.PiExponentJets.W22.MinimalParentsBelow I1 V.ideal,
            Module.length (Localization.AtPrime P.val)
              (Localization.AtPrime P.val ⧸ I1.map
                (algebraMap (Poly n) (Localization.AtPrime P.val))) *
            Module.length (Localization.AtPrime V.ideal)
              (Localization.AtPrime V.ideal ⧸ (P.val ⊔ Ideal.span {f2}).map
                (algebraMap (Poly n) (Localization.AtPrime V.ideal)))) =
          ∑ P : OAI.PiExponentJets.W22.MinimalParentsBelow I1 V.ideal,
            plen P.val P.property.1 * clen V.ideal (hF V hV).1 P.val := by
        refine Finset.sum_congr rfl ?_
        intro P _
        rfl
      rw [hrewrite, toNat_sum Finset.univ _ (fun i _ => hprod i)]
      simp only [ENat.toNat_mul]
    let parents : Finset (Ideal (Poly n)) :=
      (I1.finite_minimalPrimes_of_isNoetherianRing (Poly n)).toFinset
    have hparents (P : Ideal (Poly n)) : P ∈ parents ↔ P ∈ I1.minimalPrimes := by
      simp [parents, Set.Finite.mem_toFinset]
    let plenNat : Ideal (Poly n) → ℕ := fun P =>
      if hP : P ∈ I1.minimalPrimes then (plen P hP).toNat else 0
    let clenNat : Ideal (Poly n) → AffineVariety n → ℕ := fun P V =>
      if hV : V ∈ F then (clen V.ideal (hF V hV).1 P).toNat else 0
    have hterm (V : AffineVariety n) (hV : V ∈ F) :
        (m V : ℚ) * V.degree =
          ∑ P ∈ parents.filter (fun P => P ≤ V.ideal),
            (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree := by
      have hmemP : ∀ P : Ideal (Poly n),
          P ∈ parents.filter (fun P => P ≤ V.ideal) ↔
            P ∈ I1.minimalPrimes ∧ P ≤ V.ideal := by
        intro P
        simp [Finset.mem_filter, hparents]
      let _ : Fintype {P : Ideal (Poly n) // P ∈ I1.minimalPrimes ∧ P ≤ V.ideal} :=
        OAI.PiExponentJets.W22.minimalParentsBelow_fintype I1 V.ideal
      rw [Finset.sum_subtype (parents.filter (fun P => P ≤ V.ideal)) hmemP
        (fun P => (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree)]
      have hcast : (m V : ℚ) =
          ∑ P : {P : Ideal (Poly n) // P ∈ I1.minimalPrimes ∧ P ≤ V.ideal},
            ((plen P.1 P.2.1).toNat : ℚ) *
              ((clen V.ideal (hF V hV).1 P.1).toNat : ℚ) := by
        rw [hm_sum V hV]
        have hs :
            (∑ P : OAI.PiExponentJets.W22.MinimalParentsBelow I1 V.ideal,
              (plen P.val P.property.1).toNat *
                (clen V.ideal (hF V hV).1 P.val).toNat) =
            ∑ P : {P : Ideal (Poly n) // P ∈ I1.minimalPrimes ∧ P ≤ V.ideal},
              (plen P.1 P.2.1).toNat * (clen V.ideal (hF V hV).1 P.1).toNat := rfl
        rw [hs, Nat.cast_sum]
        refine Finset.sum_congr rfl ?_
        intro P _
        rw [Nat.cast_mul]
      rw [hcast, Finset.sum_mul]
      refine Finset.sum_congr rfl ?_
      intro P _
      simp only [plenNat, clenNat, dite_eq_left P.2.1, dite_eq_left hV]
    have hswap :
        ∑ V ∈ F, (m V : ℚ) * V.degree =
          ∑ P ∈ parents, ∑ V ∈ F.filter (fun V => P ≤ V.ideal),
            (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree := by
      have h1 : ∑ V ∈ F, (m V : ℚ) * V.degree =
          ∑ V ∈ F, ∑ P ∈ parents.filter (fun P => P ≤ V.ideal),
            (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree := by
        refine Finset.sum_congr rfl ?_
        intro V hV
        exact hterm V hV
      rw [h1]
      simp_rw [Finset.sum_filter]
      rw [Finset.sum_comm]
      try simp_rw [← Finset.sum_filter]
    have hparent (P : Ideal (Poly n)) (hP : P ∈ parents) :
        ∑ V ∈ F.filter (fun V => P ≤ V.ideal),
            (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree ≤
          (f2.totalDegree : ℚ) * ((plenNat P : ℚ) * affineDegree P) := by
      have hPmem : P ∈ I1.minimalPrimes := (hparents P).mp hP
      have hPprime : P.IsPrime := hPmem.isPrime
      by_cases hf2P : f2 ∈ P
      · have hzero : ∑ V ∈ F.filter (fun V => P ≤ V.ideal),
            (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree = 0 := by
          refine Finset.sum_eq_zero ?_
          intro V hV
          have hVF : V ∈ F := (Finset.mem_filter.mp hV).1
          have hle : P ≤ V.ideal := (Finset.mem_filter.mp hV).2
          have hI2le : I2 ≤ P := by
            refine sup_le hPmem.le ?_
            exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hf2P)
          have hminV : V.ideal ∈ I2.minimalPrimes := by
            have hmem : V.ideal ∈ (Ideal.span {f1} ⊔ Ideal.span {f2}).minimalPrimes := by
              simpa [AffineVariety.IsComponentOf, hspan] using hcomponents V hVF
            simpa [I2] using hmem
          have hEq : P = V.ideal :=
            le_antisymm hle (hminV.2 ⟨hPprime, hI2le⟩ hle)
          have hdimP : affineDimension P = n - 1 :=
            hypersurface_component_dimension hf1 hPmem
          have hdimV : V.dimension = n - 2 := (hF V hVF).2
          have hbad : n - 1 = n - 2 := by
            rw [← hdimP, hEq]
            simpa [AffineVariety.dimension] using hdimV
          exact False.elim (by omega)
        rw [hzero]
        exact mul_nonneg (Nat.cast_nonneg _)
          (mul_nonneg (Nat.cast_nonneg _)
            (zero_le_one.trans (one_le_affineDegree P hPprime.ne_top)))
      · let Y : AffineVariety n := ⟨P, hPprime.isRadical⟩
        have hYirr : Y.IsIrreducible := by
          simpa [AffineVariety.IsIrreducible, Y] using hPprime
        have hdimY : Y.dimension = (n - 2) + 1 := by
          rw [show Y.dimension = affineDimension P by rfl,
            hypersurface_component_dimension hf1 hPmem]
          omega
        have hf2Y : f2 ∉ Y.ideal := by
          simpa [Y] using hf2P
        let G : AffineFamily.Family n := F.filter (fun V => P ≤ V.ideal)
        have hG : ∀ W ∈ G, W.IsComponentOf (Y.ideal ⊔ Ideal.span {f2}) := by
          intro W hW
          have hWF := (Finset.mem_filter.mp hW).1
          have hle := (Finset.mem_filter.mp hW).2
          simpa [AffineVariety.IsComponentOf, Y] using hchild_min W hWF hPmem hle
        obtain ⟨mCut, hmCut, hbudget⟩ :=
          weighted_cut_core Y hYirr (n - 2) hdimY f2 hf2Y G hG
        have hsumEq : ∑ V ∈ G, (clenNat P V : ℚ) * V.degree =
            ∑ V ∈ G, (mCut V : ℚ) * V.degree := by
          refine Finset.sum_congr rfl ?_
          intro V hV
          have hVF := (Finset.mem_filter.mp hV).1
          have hlen : clen V.ideal (hF V hVF).1 P =
              componentLength (Y.ideal ⊔ Ideal.span {f2}) V (hF V hVF).1 := by
            simp only [clen, componentLength, Y]
          simp only [clenNat, dite_eq_left hVF, hlen, hmCut V hV (hF V hVF).1,
            ENat.toNat_natCast]
        have hfact : ∑ V ∈ G, (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree =
            (plenNat P : ℚ) * ∑ V ∈ G, (clenNat P V : ℚ) * V.degree := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl ?_
          intro V _
          rw [mul_assoc]
        calc
          ∑ V ∈ G, (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree
              = (plenNat P : ℚ) * ∑ V ∈ G, (clenNat P V : ℚ) * V.degree := hfact
          _ = (plenNat P : ℚ) * ∑ V ∈ G, (mCut V : ℚ) * V.degree := by rw [hsumEq]
          _ ≤ (plenNat P : ℚ) * ((f2.totalDegree : ℚ) * Y.degree) :=
              mul_le_mul_of_nonneg_left hbudget (Nat.cast_nonneg _)
          _ = (f2.totalDegree : ℚ) * ((plenNat P : ℚ) * affineDegree P) := by
              rw [show Y.degree = affineDegree P by rfl, mul_left_comm]
    have hfirst : ∑ P ∈ parents, (plenNat P : ℚ) * affineDegree P ≤
        (f1.totalDegree : ℚ) * (AffineVariety.whole (n := n)).degree := by
      have hrad (P : {P : Ideal (Poly n) // P ∈ parents}) : P.1.IsRadical :=
        ((hparents P.1).mp P.2).isPrime.isRadical
      let toVar : {P : Ideal (Poly n) // P ∈ parents} → AffineVariety n :=
        fun P => ⟨P.1, hrad P⟩
      let hypFamily : AffineFamily.Family n := parents.attach.image toVar
      have hinj : Set.InjOn toVar parents.attach := by
        intro a _ b _ h
        exact Subtype.ext (congrArg AffineVariety.ideal h)
      have hwholeIrr : (AffineVariety.whole (n := n)).IsIrreducible := by
        rw [AffineVariety.IsIrreducible, hwholeBot]
        exact Ideal.isPrime_bot
      have hdimWhole : (AffineVariety.whole (n := n)).dimension = (n - 1) + 1 := by
        rw [whole_dimension]
        omega
      have hf1out : f1 ∉ (AffineVariety.whole (n := n)).ideal := by
        rw [hwholeBot]
        intro hmem
        exact hf1 (Ideal.mem_bot.mp hmem)
      have hhypComp : ∀ W ∈ hypFamily,
          W.IsComponentOf
            ((AffineVariety.whole (n := n)).ideal ⊔ Ideal.span {f1}) := by
        intro W hW
        obtain ⟨P, hP, rfl⟩ := Finset.mem_image.mp hW
        rw [hwholeBot, bot_sup_eq]
        simpa [AffineVariety.IsComponentOf, toVar, I1] using (hparents P.1).mp P.2
      obtain ⟨mHyp, hmHyp, hbudget⟩ := weighted_cut_core (AffineVariety.whole (n := n))
        hwholeIrr (n - 1) hdimWhole f1 hf1out hypFamily hhypComp
      have hmemEq : ∑ W ∈ hypFamily, (mHyp W : ℚ) * W.degree =
          ∑ P ∈ parents, (plenNat P : ℚ) * affineDegree P := by
        rw [Finset.sum_image hinj]
        have hpoint : ∑ P ∈ parents.attach, (mHyp (toVar P) : ℚ) * (toVar P).degree =
            ∑ P ∈ parents.attach, (plenNat P.1 : ℚ) * affineDegree P.1 := by
          refine Finset.sum_congr rfl ?_
          intro P _
          have hPmem := (hparents P.1).mp P.2
          have hIrr : (toVar P).IsIrreducible := by
            simpa [AffineVariety.IsIrreducible, toVar] using hPmem.isPrime
          have hIn : toVar P ∈ hypFamily :=
            Finset.mem_image_of_mem toVar (Finset.mem_attach parents P)
          have hlen : plen P.1 hPmem =
              componentLength
                ((AffineVariety.whole (n := n)).ideal ⊔ Ideal.span {f1})
                (toVar P) hIrr := by
            rw [hwholeBot, bot_sup_eq]
            rfl
          have hnat : mHyp (toVar P) = plenNat P.1 := by
            simp only [plenNat, dite_eq_left hPmem]
            rw [← ENat.toNat_natCast (mHyp (toVar P))]
            exact congrArg ENat.toNat
              ((hlen.trans (hmHyp (toVar P) hIn hIrr)).symm)
          simp only [hnat, AffineVariety.degree, toVar]
        rw [hpoint]
        exact Finset.sum_attach parents (fun P => (plenNat P : ℚ) * affineDegree P)
      exact hmemEq.symm.trans_le hbudget
    have hprodDeg : ∏ i, ((f i).totalDegree : ℚ) =
        ((f 0).totalDegree : ℚ) * ((f 1).totalDegree : ℚ) := by
      simp only [Fin.prod_univ_succ, Fin.prod_univ_zero, mul_one, Fin.succ_zero_eq_one']
    calc
      ∑ V ∈ F, (m V : ℚ) * V.degree
          = ∑ P ∈ parents, ∑ V ∈ F.filter (fun V => P ≤ V.ideal),
              (plenNat P : ℚ) * (clenNat P V : ℚ) * V.degree := hswap
      _ ≤ ∑ P ∈ parents,
            (f2.totalDegree : ℚ) * ((plenNat P : ℚ) * affineDegree P) :=
          Finset.sum_le_sum hparent
      _ = (f2.totalDegree : ℚ) *
            ∑ P ∈ parents, (plenNat P : ℚ) * affineDegree P :=
          (Finset.mul_sum parents
            (fun P => (plenNat P : ℚ) * affineDegree P) (f2.totalDegree : ℚ)).symm
      _ ≤ (f2.totalDegree : ℚ) *
            ((f1.totalDegree : ℚ) * (AffineVariety.whole (n := n)).degree) :=
          mul_le_mul_of_nonneg_left hfirst (Nat.cast_nonneg _)
      _ = ((f 0).totalDegree : ℚ) * ((f 1).totalDegree : ℚ) := by
          simp only [whole_degree, f1, f2, mul_one]
          ring
      _ = ∏ i, ((f i).totalDegree : ℚ) := hprodDeg.symm

end
end DistinctDistances.TrackA
