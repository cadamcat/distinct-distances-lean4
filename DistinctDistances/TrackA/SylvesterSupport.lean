import DistinctDistances.TrackA.DepthDefinitions
import DistinctDistances.OAIInterface.PlaneHilbert

namespace DistinctDistances.TrackA
noncomputable section
open scoped Classical
open OAI.PermanentBorder.PlaneHilbert OAI.PermanentBorder.Multigraded

/-- Removing an actual gcd leaves relatively prime factors, independently
of the chosen normalization of the gcd structure. -/
theorem sylvester_factors_relPrime {R : Type*} [CommMonoidWithZero R]
    [IsCancelMulZero R] [GCDMonoid R] {f g u v : R}
    (hH : gcd f g ≠ 0) (hf : f = gcd f g * u) (hg : g = gcd f g * v) :
    IsRelPrime u v := by
  intro a hau hav
  apply isUnit_iff_dvd_one.mpr
  have ha : gcd f g * a ∣ gcd f g := by
    apply dvd_gcd
    · exact (mul_dvd_mul_left (gcd f g) hau).trans (dvd_of_eq hf.symm)
    · exact (mul_dvd_mul_left (gcd f g) hav).trans (dvd_of_eq hg.symm)
  have ha' : gcd f g * a ∣ gcd f g * 1 := by simpa using ha
  exact (mul_dvd_mul_iff_left hH).mp ha'

section Binary
variable {K : Type*} [Field K]

theorem sylvester_range_congr {f g : Plane (K := K)} {e d : ℤ}
    (hf : f.IsWeightedHomogeneous weight e) (hg : g.IsWeightedHomogeneous weight d)
    (hfg : f = g) (hed : e = d) (t : ℤ) :
    multiplicationRange hf t = multiplicationRange hg t := by
  cases hfg
  cases hed
  rfl

theorem sylvester_range_zero {f : Plane (K := K)} {e : ℤ}
    (hf : f.IsWeightedHomogeneous weight e) (hf0 : f = 0) (t : ℤ) :
    multiplicationRange hf t = ⊥ := by
  have hz : mulPiece weight hf t = 0 := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change f*x.val = 0
    simp [hf0]
  rw [multiplicationRange, hz, LinearMap.range_zero]

theorem sylvester_gcd_degree_zero_left (g : Plane (K := K)) (hg : g ≠ 0) :
    (binaryGcd 0 g).totalDegree = g.totalDegree := by
  letI : NormalizedGCDMonoid (Plane (K := K)) := Classical.arbitrary _
  change (gcd 0 g).totalDegree = g.totalDegree
  have hh : gcd 0 g ≠ 0 := by
    intro hz
    have h : (0 : Plane (K := K)) ∣ g := by
      simpa only [hz] using gcd_dvd_right 0 g
    exact hg (zero_dvd_iff.mp h)
  exact le_antisymm
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain (gcd_dvd_right 0 g) hg)
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain (dvd_gcd (dvd_zero g) (dvd_refl g)) hh)

theorem sylvester_gcd_degree_zero_right (f : Plane (K := K)) (hf : f ≠ 0) :
    (binaryGcd f 0).totalDegree = f.totalDegree := by
  letI : NormalizedGCDMonoid (Plane (K := K)) := Classical.arbitrary _
  change (gcd f 0).totalDegree = f.totalDegree
  have hh : gcd f 0 ≠ 0 := by
    intro hz
    have h : (0 : Plane (K := K)) ∣ f := by
      simpa only [hz] using gcd_dvd_left f 0
    exact hf (zero_dvd_iff.mp h)
  exact le_antisymm
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain (gcd_dvd_left f 0) hf)
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain (dvd_gcd (dvd_refl f) (dvd_zero f)) hh)

/-- Multiplication by a common homogeneous factor transports the graded
multiplication range without changing the degree of the ambient section. -/
theorem sylvester_range_product {h u : Plane (K := K)} {d e : ℤ}
    (hh : h.IsWeightedHomogeneous weight d) (hu : u.IsWeightedHomogeneous weight e)
    (t : ℤ) :
    multiplicationRange (hh.mul hu) t =
      (multiplicationRange hu (t-d)).map (mulPiece weight hh t) := by
  ext p
  constructor
  · rintro ⟨a, ha⟩
    let a' : H (K := K) ((t-d)-e) := ⟨a.val, by
      convert a.property using 1 <;> ring⟩
    refine ⟨mulPiece weight hu (t-d) a', ⟨a', rfl⟩, ?_⟩
    apply Subtype.ext
    change h * (u * a.val) = p.val
    have hp : (h*u) * a.val = p.val := congrArg Subtype.val ha
    simpa only [mul_assoc] using hp
  · rintro ⟨x, ⟨a, ha⟩, hp⟩
    let a' : H (K := K) (t-(d+e)) := ⟨a.val, by
      convert a.property using 1 <;> ring⟩
    refine ⟨a', ?_⟩
    apply Subtype.ext
    change (h*u) * a.val = p.val
    have hx : u * a.val = x.val := congrArg Subtype.val ha
    have hpx : h * x.val = p.val := congrArg Subtype.val hp
    rw [mul_assoc, hx, hpx]

/-- The intersection for forms sharing a factor is the transported
coprime intersection from OAI, hence is generated by their homogeneous lcm. -/
theorem sylvester_range_inf_common_factor {h u v : Plane (K := K)} {d e f : ℤ}
    (hh : h.IsWeightedHomogeneous weight d) (hu : u.IsWeightedHomogeneous weight e)
    (hv : v.IsWeightedHomogeneous weight f) (hh0 : h ≠ 0) (hv0 : v ≠ 0)
    (huv : IsRelPrime u v) (t : ℤ) :
    multiplicationRange (hh.mul hu) t ⊓ multiplicationRange (hh.mul hv) t =
      multiplicationRange (hh.mul (hu.mul hv)) t := by
  rw [sylvester_range_product hh hu, sylvester_range_product hh hv,
    sylvester_range_product hh (hu.mul hv)]
  rw [← Submodule.map_inf (mulPiece weight hh t) (mulPiece_injective hh hh0 t),
    multiplicationRange_inf hu hv hv0 huv]

/-- Counting the common-factor intersection gives the rank contribution
of two degree-L homogeneous multiplication ranges. -/
theorem sylvester_range_rank {h u v : Plane (K := K)} (L d : ℕ) (hd : d ≤ L)
    (hh : h.IsWeightedHomogeneous weight (d : ℤ))
    (hu : u.IsWeightedHomogeneous weight ((L : ℤ)-d))
    (hv : v.IsWeightedHomogeneous weight ((L : ℤ)-d))
    (hh0 : h ≠ 0) (hu0 : u ≠ 0) (hv0 : v ≠ 0) (huv : IsRelPrime u v) :
    Module.finrank K
      ↥(multiplicationRange (hh.mul hu) (2*(L : ℤ)-1) ⊔
        multiplicationRange (hh.mul hv) (2*(L : ℤ)-1)) = 2*L-d := by
  have hr := Submodule.finrank_sup_add_finrank_inf_eq
    (multiplicationRange (hh.mul hu) (2*(L : ℤ)-1))
    (multiplicationRange (hh.mul hv) (2*(L : ℤ)-1))
  rw [sylvester_range_inf_common_factor hh hu hv hh0 hv0 huv,
    finrank_multiplicationRange (hh.mul hu) (mul_ne_zero hh0 hu0),
    finrank_multiplicationRange (hh.mul hv) (mul_ne_zero hh0 hv0),
    finrank_multiplicationRange (hh.mul (hu.mul hv))
      (mul_ne_zero hh0 (mul_ne_zero hu0 hv0))] at hr
  have hL : (2*(L : ℤ)-1-((d : ℤ)+((L : ℤ)-d))+1).toNat = L := by omega
  have hd' : (2*(L : ℤ)-1-((d : ℤ)+(((L : ℤ)-d)+((L : ℤ)-d)))+1).toNat = d := by
    omega
  rw [hL, hd'] at hr
  omega

/-- The binary gcd supplies actual relatively prime homogeneous factors.
Both nonzero forms are handled here; one-zero matrices are treated separately. -/
theorem sylvester_gcd_factors (f g : Plane (K := K)) (L : ℕ)
    (hf : f.IsHomogeneous L) (hg : g.IsHomogeneous L) (hf0 : f ≠ 0) (hg0 : g ≠ 0) :
    (binaryGcd f g).totalDegree ≤ L ∧
    (binaryGcd f g).IsWeightedHomogeneous weight ((binaryGcd f g).totalDegree : ℤ) ∧
    ∃ u v : Plane (K := K), f = binaryGcd f g * u ∧ g = binaryGcd f g * v ∧
      binaryGcd f g ≠ 0 ∧ u ≠ 0 ∧ v ≠ 0 ∧ IsRelPrime u v ∧
      u.IsWeightedHomogeneous weight ((L : ℤ)-(binaryGcd f g).totalDegree) ∧
      v.IsWeightedHomogeneous weight ((L : ℤ)-(binaryGcd f g).totalDegree) := by
  letI : NormalizedGCDMonoid (Plane (K := K)) := Classical.arbitrary _
  change (gcd f g).totalDegree ≤ L ∧
    (gcd f g).IsWeightedHomogeneous weight ((gcd f g).totalDegree : ℤ) ∧
    ∃ u v : Plane (K := K), f = gcd f g * u ∧ g = gcd f g * v ∧
      gcd f g ≠ 0 ∧ u ≠ 0 ∧ v ≠ 0 ∧ IsRelPrime u v ∧
      u.IsWeightedHomogeneous weight ((L : ℤ)-(gcd f g).totalDegree) ∧
      v.IsWeightedHomogeneous weight ((L : ℤ)-(gcd f g).totalDegree)
  obtain ⟨u, hu⟩ := gcd_dvd_left f g
  obtain ⟨v, hv⟩ := gcd_dvd_right f g
  have hh0 : gcd f g ≠ 0 := by
    intro hz
    exact hf0 (by simpa [hz] using hu)
  have hu0 : u ≠ 0 := by
    intro hz
    exact hf0 (by simpa [hz] using hu)
  have hv0 : v ≠ 0 := by
    intro hz
    exact hg0 (by simpa [hz] using hv)
  have hh : (gcd f g).IsHomogeneous (gcd f g).totalDegree :=
    OAI.Nagata.Workers.W30.homogeneous_of_dvd hf0 hf (gcd_dvd_left f g)
  have hd : (gcd f g).totalDegree ≤ L := by
    have h := MvPolynomial.totalDegree_mul_of_isDomain hh0 hu0
    rw [← hu, hf.totalDegree hf0] at h
    omega
  have hhw := OAI.PermanentBorder.SliceParameters.homogeneous_intWeight hh
  have huf := OAI.PermanentBorder.SliceParameters.homogeneous_intWeight hf
  have hvg := OAI.PermanentBorder.SliceParameters.homogeneous_intWeight hg
  refine ⟨hd, hhw, u, v, hu, hv, hh0, hu0, hv0,
    sylvester_factors_relPrime hh0 hu hv, ?_, ?_⟩
  · exact homogeneous_factor_right hhw hh0 (hu ▸ huf)
  · exact homogeneous_factor_right hhw hh0 (hv ▸ hvg)

end Binary

end
end DistinctDistances.TrackA
